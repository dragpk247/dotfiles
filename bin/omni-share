#!/usr/bin/env python3
"""
OMNI Share — Ad-Hoc File & Folder Sharing Engine
Supports:
1. Local Wi-Fi sharing with terminal QR Code (for iPhones, Android, Mac, PC on same network)
2. Public Internet sharing via Tailscale Funnel (anyone anywhere in the world without Tailscale)
3. One-time or persistent download with automatic cleanup
"""

import sys
import os
import socket
import argparse
import http.server
import socketserver
import threading
import urllib.parse
import signal
import subprocess

def get_local_ip():
    """Finds best non-loopback IP address for local network access."""
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        # Does not actually send data
        s.connect(('10.255.255.255', 1))
        ip = s.getsockname()[0]
    except Exception:
        ip = '127.0.0.1'
    finally:
        s.close()
    return ip

def generate_terminal_qr(url):
    """Renders a UTF-8 compact QR code directly in the terminal."""
    try:
        # Try qrencode if available
        res = subprocess.run(['qrencode', '-t', 'UTF8', url], capture_output=True, text=True)
        if res.returncode == 0 and res.stdout.strip():
            return res.stdout
    except Exception:
        pass

    # Pure Python fallback using basic ASCII box border if qrencode not installed
    border = "=" * (len(url) + 4)
    return f"{border}\n  {url}\n{border}\n(Scan via mobile camera or browser)"

class SingleFileHandler(http.server.SimpleHTTPRequestHandler):
    target_path = ""
    is_dir = False
    download_count = 0
    max_downloads = 1
    shutdown_callback = None

    def translate_path(self, path):
        if self.is_dir:
            req_path = urllib.parse.unquote(path).lstrip('/')
            return os.path.join(self.target_path, req_path)
        return self.target_path

    def end_headers(self):
        filename = os.path.basename(self.target_path)
        if not self.is_dir:
            self.send_header('Content-Disposition', f'attachment; filename="{filename}"')
        super().end_headers()

    def do_GET(self):
        super().do_GET()
        if not self.is_dir or self.path != '/':
            SingleFileHandler.download_count += 1
            if SingleFileHandler.max_downloads and SingleFileHandler.download_count >= SingleFileHandler.max_downloads:
                print("\n\033[1;32m[✓] Download completed by client!\033[0m")
                if SingleFileHandler.shutdown_callback:
                    threading.Thread(target=SingleFileHandler.shutdown_callback).start()

def main():
    parser = argparse.ArgumentParser(description="OMNI Ad-Hoc File Sharing")
    parser.add_argument("path", help="Path to file or directory to share")
    parser.add_argument("-p", "--port", type=int, default=8989, help="Port to serve on (default: 8989)")
    parser.add_argument("--public", action="store_true", help="Share over public internet via Tailscale Funnel")
    parser.add_argument("--unlimited", action="store_true", help="Keep running after first download")
    args = parser.parse_args()

    target = os.path.abspath(args.path)
    if not os.path.exists(target):
        print(f"\033[1;31m[!] Error: File '{target}' does not exist.\033[0m")
        sys.exit(1)

    is_dir = os.path.isdir(target)
    SingleFileHandler.target_path = target
    SingleFileHandler.is_dir = is_dir
    SingleFileHandler.max_downloads = 0 if args.unlimited else 1

    port = args.port
    # Find available port
    while True:
        try:
            httpd = socketserver.TCPServer(("", port), SingleFileHandler)
            break
        except OSError:
            port += 1

    def shutdown():
        httpd.shutdown()

    SingleFileHandler.shutdown_callback = shutdown

    local_ip = get_local_ip()
    share_url = f"http://{local_ip}:{port}/"
    funnel_proc = None

    if args.public:
        print("\033[1;36m[*] Configuring Tailscale Funnel for public internet access...\033[0m")
        try:
            # Enable Funnel on this port
            funnel_proc = subprocess.Popen(['tailscale', 'funnel', '--bg', str(port)], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            funnel_proc.wait(timeout=5)
            # Fetch node DNS name
            res = subprocess.run(['tailscale', 'status', '--json'], capture_output=True, text=True)
            import json
            data = json.loads(res.stdout)
            dns_name = data.get("Self", {}).get("DNSName", "").rstrip(".")
            if dns_name:
                share_url = f"https://{dns_name}/"
                print("\033[1;32m[✓] Public Funnel URL active!\033[0m")
        except Exception as e:
            print(f"\033[1;33m[!] Could not activate Funnel: {e}. Falling back to local network URL.\033[0m")

    filename = os.path.basename(target)
    file_size_mb = os.path.getsize(target) / (1024 * 1024) if not is_dir else 0

    print("\n\033[1;36m===============================================================\033[0m")
    print(f" 🌐 OMNI SHARE — {'Folder' if is_dir else 'File'}: \033[1m{filename}\033[0m ({file_size_mb:.2f} MB)")
    print("\033[1;36m===============================================================\033[0m")
    print(f"\nShare URL: \033[1;32m{share_url}\033[0m\n")

    qr = generate_terminal_qr(share_url)
    print(qr)
    print("\n\033[2mInstructions:\033[0m")
    print("  • Point iPhone or Android camera at the QR code above.")
    print("  • Or open the URL in any browser on iOS, Mac, Windows, Linux.")
    if not args.unlimited:
        print("  • Server will automatically close after the transfer finishes.")
    print("\nPress Ctrl+C to cancel.")

    def handle_sigint(sig, frame):
        print("\n\033[1;33m[*] Stopping share server...\033[0m")
        if args.public:
            try:
                subprocess.run(['tailscale', 'funnel', 'reset'], capture_output=True)
            except Exception:
                pass
        sys.exit(0)

    signal.signal(signal.SIGINT, handle_sigint)

    try:
        httpd.serve_forever()
    finally:
        if args.public:
            try:
                subprocess.run(['tailscale', 'funnel', 'reset'], capture_output=True)
            except Exception:
                pass

if __name__ == "__main__":
    main()
