#!/usr/bin/env bash
# ==============================================================================
#  OMNI-MOCK — Safe Sandbox Playground for OMNI Features
#  Allows testing: Onboarding Wizard, MAC detection, Area Toggles, Custom Tools
#  WITHOUT modifying your real ~/.config/omni/config.env!
# ==============================================================================

set -uo pipefail

# 1. Isolated sandbox directories
MOCK_DIR="/tmp/omni-mock-$$"
mkdir -p "$MOCK_DIR/config" "$MOCK_DIR/cache"

cleanup() {
  rm -rf "$MOCK_DIR" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# 2. Re-route config and cache to sandbox
export XDG_CONFIG_HOME="$MOCK_DIR/config"
export XDG_CACHE_HOME="$MOCK_DIR/cache"

CONFIG_DIR="$MOCK_DIR/config/omni"
CONFIG_FILE="$CONFIG_DIR/config.env"
CUSTOM_TOOLS_FILE="$CONFIG_DIR/custom_tools.conf"

mkdir -p "$CONFIG_DIR"

# Colors
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_RED="\033[1;31m"
C_YELLOW="\033[1;33m"
C_MAGENTA="\033[1;35m"
C_BLUE="\033[1;34m"
C_DIM="\033[2m"

clear
echo -e "${C_CYAN}${C_BOLD}"
cat << "BANNER"
  ___  __  __ _   _ ___       __  __  ___   ____ _  __
 / _ \|  \/  | \ | |_ _|     |  \/  |/ _ \ / ___| |/ /
| | | | |\/| |  \| || | _____| |\/| | | | | |   | ' / 
| |_| | |  | | |\  || | _____| |  | | |_| | |___| . \ 
 \___/|_|  |_|_| \_|___|     |_|  |_|\___/ \____|_|\_\ (SANDBOX)
BANNER
echo -e "${C_RESET}${C_DIM}─────────────────────────────────────────────────────────────────${C_RESET}"
echo -e " ${C_BOLD}Welcome to the OMNI Mock & Sandbox Environment${C_RESET}"
echo -e " ${C_GREEN}[i] Sandbox Path: $MOCK_DIR${C_RESET}"
echo -e " ${C_GREEN}[i] Your real ~/.config/omni/ is 100% PROTECTED and untouched.${C_RESET}"
echo -e "${C_DIM}─────────────────────────────────────────────────────────────────${C_RESET}\n"

echo -e "Select how you would like to run the mock test:"
echo -e "  ${C_CYAN}[1]${C_RESET} 🧙 Run the Full First-Time Setup Wizard (From Scratch)"
echo -e "  ${C_CYAN}[2]${C_RESET} 🧪 Launch Mock Menu with Custom Tools & Modular Areas"
echo -e "  ${C_CYAN}[3]${C_RESET} ⚡ Test Individual Features (MAC Scan, Tailscale Latency, Custom Tools Engine)"
read -r -p "Enter choice [1-3, default: 1]: " mode
mode="${mode:-1}"

# Source the core library but inside sandbox
if [ -f "$HOME/dotfiles/bin/omni-core.sh" ]; then
  source "$HOME/dotfiles/bin/omni-core.sh"
  OMNI_BIN_DIR="$HOME/dotfiles/bin"
elif [ -f "$HOME/bin/omni-core.sh" ]; then
  source "$HOME/bin/omni-core.sh"
  OMNI_BIN_DIR="$HOME/bin"
else
  source "$(dirname "$(which omni 2>/dev/null || echo "$0")")/omni-core.sh"
  OMNI_BIN_DIR="$(dirname "$(which omni 2>/dev/null || echo "$0")")"
fi

omni_mock_launch_ui() {
  local dev_role="${1:-$(omni_detect_device)}"
  case "$dev_role" in
    phone)
      [ -f "$OMNI_BIN_DIR/omni-phone" ] && exec "$OMNI_BIN_DIR/omni-phone"
      ;;
    laptop)
      [ -f "$OMNI_BIN_DIR/omni-laptop" ] && exec "$OMNI_BIN_DIR/omni-laptop"
      ;;
    *)
      [ -f "$OMNI_BIN_DIR/omni-desktop" ] && exec "$OMNI_BIN_DIR/omni-desktop"
      ;;
  esac
}

case "$mode" in
  1)
    echo -e "\n${C_CYAN}[*] Starting Interactive Wizard in Sandbox...${C_RESET}\n"
    omni_run_setup
    echo -e "\n${C_CYAN}─── Inspecting Generated Sandbox Config ───${C_RESET}"
    if [ -f "$CONFIG_FILE" ]; then
      cat "$CONFIG_FILE"
      echo ""
      read -r -p "Launch interactive menu with this new test config now? (Y/n): " launch_menu
      if [[ ! "$launch_menu" =~ ^[Nn]$ ]]; then
        omni_mock_launch_ui "$this_role"
      fi
    else
      echo -e "${C_RED}[!] No config generated.${C_RESET}"
    fi
    ;;

  2)
    # Pre-populate sandbox with custom mock settings and a custom tool
    cat << CONF > "$CONFIG_FILE"
THIS_DEVICE_ROLE="desktop"
DESKTOP_IP="127.0.0.1"
DESKTOP_MAC="34:5a:60:b6:62:e1"
DESKTOP_USER="$USER"
LAPTOP_IP="127.0.0.1"
LAPTOP_MAC="00:11:22:33:44:55"
LAPTOP_USER="$USER"
PHONE_IP="127.0.0.1"
PHONE_PORT="8022"
PHONE_USER="u0_test"

OMNI_ENABLE_AI="true"
OMNI_ENABLE_FLEET="true"
OMNI_ENABLE_SYSTEM="true"
OMNI_ENABLE_CLIPBOARD="true"

OMNI_AI_ENGINE="agy"
OMNI_SYS_MONITOR="fastfetch"
CONF

    cat << TOOLS > "$CUSTOM_TOOLS_FILE"
# Mock custom tools registered for testing
b | 🌐 Fastfetch System Spec   | fastfetch
p | 🏓 Mock Ping Test          | ping -c 2 127.0.0.1
e | 🧪 Echo Test Payload       | echo 'Omni Sandbox Custom Tool Executed Successfully!'
TOOLS

    chmod 600 "$CONFIG_FILE"
    echo -e "\n${C_GREEN}[✓] Mock sandbox configured with custom tools and fastfetch monitor.${C_RESET}"
    echo -e "${C_CYAN}[*] Launching Sandbox Menu...${C_RESET}\n"
    sleep 1
    omni_mock_launch_ui "phone"
    ;;

  3)
    echo -e "\n${C_CYAN}${C_BOLD}=== Feature Diagnostic Tests ===${C_RESET}\n"

    echo -e "${C_BOLD}Test 1: Hardware Network Interfaces & MAC Detection${C_RESET}"
    for iface_path in /sys/class/net/*; do
      [ -d "$iface_path" ] || continue
      iname=$(basename "$iface_path")
      [[ "$iname" =~ ^(lo|docker.*|veth.*|br-.*|virbr.*|tailscale.*|wg.*)$ ]] && continue
      [ -f "$iface_path/address" ] || continue
      imac=$(cat "$iface_path/address" 2>/dev/null)
      [ -z "$imac" ] || [ "$imac" = "00:00:00:00:00:00" ] && continue
      istate="unknown"
      [ -f "$iface_path/operstate" ] && istate=$(cat "$iface_path/operstate")
      echo -e "  • ${C_CYAN}$iname${C_RESET} ➜ MAC: ${C_YELLOW}$imac${C_RESET} (State: $istate)"
    done

    echo -e "\n${C_BOLD}Test 2: Tailscale Node Discovery & Mesh Ping${C_RESET}"
    if command -v tailscale >/dev/null 2>&1; then
      echo "  • Self Tailscale IP: $(tailscale ip -4 2>/dev/null || echo "None")"
      echo -e "  • Tailnet Peers:"
      tailscale status 2>/dev/null | head -n 5 | sed 's/^/    /'
    else
      echo -e "  • Tailscale not installed."
    fi

    echo -e "\n${C_BOLD}Test 3: Custom Tools Conf Parser Engine${C_RESET}"
    cat << TOOLS > "$CUSTOM_TOOLS_FILE"
g | 🐙 Lazygit Git UI           | echo "Simulating Lazygit launch"
d | 🐳 Lazydocker Containers    | echo "Simulating Lazydocker launch"
TOOLS
    omni_render_custom_tools
    echo -e "\nSimulating trigger of custom key 'g':"
    omni_exec_custom_tool "g"
    ;;
esac
