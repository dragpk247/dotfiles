#!/usr/bin/env bash
# ==============================================================================
#  OMNI SENTINEL — Fleet Telemetry & Battery Alert Daemon
#  Monitors battery status across fleet and pushes proactive warnings
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/omni-core.sh"

CURRENT_DEV=$(omni_detect_device)

echo -e "${C_CYAN}${C_BOLD}"
cat << "BANNER"
  ___  __  __ _   _ ___   ____  _____ _   _ _____ ___ _   _ _____ _     
 / _ \|  \/  | \ | |_ _| / ___|| ____| \ | |_   _|_ _| \ | | ____| |    
| | | | |\/| |  \| || |  \___ \|  _| |  \| | | |  | ||  \| |  _| | |    
| |_| | |  | | |\  || |   ___) | |___| |\  | | |  | || |\  | |___| |___ 
 \___/|_|  |_|_| \_|___| |____/|_____|_| \_| |_| |___|_| \_|_____|_____|
BANNER
echo -e "${C_RESET}${C_DIM}─────────────────────────────────────────────────────────────────${C_RESET}"
echo -e " ${C_BOLD}Fleet Telemetry Sentinel & Proactive Battery Monitor${C_RESET}"
echo -e "${C_DIM}─────────────────────────────────────────────────────────────────${C_RESET}\n"

echo -e "${C_BOLD}Current Fleet Telemetry Snap:${C_RESET}"

# 1. Desktop Telemetry
if omni_is_online "$DESKTOP_IP"; then
  d_gpu=$(ssh -o ConnectTimeout=2 "${DESKTOP_USER}@${DESKTOP_IP}" "nvidia-smi --query-gpu=utilization.gpu,temperature.gpu,memory.used --format=csv,noheader,nounits 2>/dev/null" || echo "")
  if [ -n "$d_gpu" ]; then
    echo -e "  • ${C_CYAN}Desktop Workstation:${C_RESET} ${C_GREEN}Online${C_RESET} | GPU: ${d_gpu}% util / temp"
  else
    echo -e "  • ${C_CYAN}Desktop Workstation:${C_RESET} ${C_GREEN}Online${C_RESET} (CPU only)"
  fi
else
  echo -e "  • ${C_CYAN}Desktop Workstation:${C_RESET} ${C_RED}Offline${C_RESET}"
fi

# 2. Laptop Battery & Status
if omni_is_online "$LAPTOP_IP"; then
  l_bat=$(ssh -o ConnectTimeout=2 "${LAPTOP_USER}@${LAPTOP_IP}" "cat /sys/class/power_supply/BAT0/capacity 2>/dev/null" || echo "")
  l_ac=$(ssh -o ConnectTimeout=2 "${LAPTOP_USER}@${LAPTOP_IP}" "cat /sys/class/power_supply/AC0/online 2>/dev/null" || echo "")
  if [ -n "$l_bat" ]; then
    ac_icon="🔋"
    [ "$l_ac" = "1" ] && ac_icon="⚡ (Plugged)"
    if [ "$l_bat" -le 15 ] && [ "$l_ac" != "1" ]; then
      echo -e "  • ${C_CYAN}ROG Laptop:${C_RESET} ${C_RED}CRITICAL ${l_bat}% $ac_icon${C_RESET} ⚠️"
      "$SCRIPT_DIR/omni-notify" "Laptop battery critically low at ${l_bat}%!" "OMNI Sentinel Alert"
    else
      echo -e "  • ${C_CYAN}ROG Laptop:${C_RESET} ${C_GREEN}${l_bat}% $ac_icon${C_RESET}"
    fi
  else
    echo -e "  • ${C_CYAN}ROG Laptop:${C_RESET} ${C_GREEN}Online${C_RESET} (No battery found)"
  fi
else
  echo -e "  • ${C_CYAN}ROG Laptop:${C_RESET} ${C_RED}Offline${C_RESET}"
fi

# 3. Phone Battery
if [ "$CURRENT_DEV" = "phone" ]; then
  p_bat=$(termux-battery-status 2>/dev/null | jq -r .percentage 2>/dev/null || echo "?")
  echo -e "  • ${C_CYAN}S24 Phone (Local):${C_RESET} ${C_GREEN}${p_bat}%${C_RESET}"
elif omni_is_online "$PHONE_IP"; then
  p_bat=$(ssh -p "$PHONE_PORT" -o ConnectTimeout=2 "${PHONE_USER}@${PHONE_IP}" "termux-battery-status 2>/dev/null | jq -r .percentage 2>/dev/null" || echo "?")
  echo -e "  • ${C_CYAN}S24 Phone:${C_RESET} ${C_GREEN}${p_bat}%${C_RESET}"
else
  echo -e "  • ${C_CYAN}S24 Phone:${C_RESET} ${C_RED}Offline${C_RESET}"
fi

echo -e "\n${C_DIM}─────────────────────────────────────────────────────────────────${C_RESET}"
echo -e "Navigation: [b] Back to OMNI Menu  |  [Enter / q] Exit to Shell"
read -rsn1 -p "Select action: " nav_act
echo ""

case "$nav_act" in
  b|B) exec omni ;;
  *) exit 0 ;;
esac
