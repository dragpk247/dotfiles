#!/usr/bin/env bash
# ==============================================================================
#  OMNI DESKTOP — Dedicated Workstation Interface
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/omni-core.sh"

while true; do
  p_stat="${C_RED}Offline${C_RESET}"; omni_is_online "$PHONE_IP" && p_stat="${C_GREEN}Online${C_RESET}"
  l_stat="${C_RED}Offline${C_RESET}"; omni_is_online "$LAPTOP_IP" && l_stat="${C_GREEN}Online${C_RESET}"

  omni_render_header "Desktop Workstation ($(hostname))" "│ Phone: $p_stat │ Laptop: $l_stat"

  echo -e "${C_CYAN}${C_BOLD}  🚀 LOCAL AI WORKSPACES (tmux)${C_RESET}"
  echo -e "  ${C_CYAN}[1]${C_RESET} 🤖 Antigravity / Agy      (Local 'ai' session)"
  echo -e "  ${C_CYAN}[2]${C_RESET} 🟣 Claude Code            (Local 'claude' session)"
  echo -e "  ${C_CYAN}[3]${C_RESET} 💻 Aider Pair Programmer  (Local 'aider' session)"
  echo -e "  ${C_CYAN}[4]${C_RESET} 🕊️  Hermes Gateway         (Local 'hermes' session)"
  echo -e "  ${C_CYAN}[5]${C_RESET} ⚡ Jev Intelligent Router (Interactive chat)"
  echo ""
  echo -e "${C_MAGENTA}${C_BOLD}  📱 MOBILE PHONE ($PHONE_IP)${C_RESET}"
  echo -e "  ${C_CYAN}[9]${C_RESET} 📱 Phone Termux SSH Shell (Port $PHONE_PORT)"
  echo -e "  ${C_CYAN}[0]${C_RESET} 📱 Phone Screen Mirror    (scrcpy)"
  echo -e "  ${C_CYAN}[y]${C_RESET} 📤 Push Updates to Phone"
  echo ""
  echo -e "${C_YELLOW}${C_BOLD}  💻 LAPTOP ($LAPTOP_IP)${C_RESET}"
  echo -e "  ${C_CYAN}[l]${C_RESET} 💻 Laptop SSH Shell"
  echo ""
  echo -e "${C_BLUE}${C_BOLD}  📁 3-WAY FILE TRANSFER${C_RESET}"
  echo -e "  ${C_CYAN}[f]${C_RESET} 📁 Send File to Laptop or Phone (omni send)"
  echo ""
  echo -e "${C_GREEN}${C_BOLD}  📊 TELEMETRY & CONTROLS${C_RESET}"
  echo -e "  ${C_CYAN}[t]${C_RESET} 📊 Local System Monitor   (htop / desk-top)"
  echo -e "  ${C_CYAN}[u]${C_RESET} 🎮 NVIDIA GPU Status"
  echo -e "  ${C_CYAN}[k]${C_RESET} 🔒 Lock Desktop Screen"
  echo -e "  ${C_CYAN}[s]${C_RESET} 🐚 Drop to Local Shell"
  echo -e "  ${C_RED}[e]${C_RESET} 🚪 Exit"
  echo ""
  read -r -p "Select option: " choice

  case "$choice" in
    1) [ -f "$HOME/ap" ] && "$HOME/ap" || agy ;;
    2) [ -f "$HOME/.local/bin/claude-phone" ] && "$HOME/.local/bin/claude-phone" || claude ;;
    3) [ -f "$HOME/.local/bin/aider-phone" ] && "$HOME/.local/bin/aider-phone" || aider ;;
    4) tmux attach -t hermes 2>/dev/null || tmux new-session -s hermes 'hermes chat' ;;
    5) [ -f "$HOME/.local/bin/jev-chat" ] && "$HOME/.local/bin/jev-chat" ;;
    9) ssh -p "$PHONE_PORT" "${PHONE_USER}@${PHONE_IP}" ;;
    0) 
      adb connect "${PHONE_IP}:5555" 2>/dev/null || true
      scrcpy --stay-awake --turn-screen-off || scrcpy
      ;;
    f|F)
      read -e -p "Enter path to file: " fpath
      [ -n "$fpath" ] && "$SCRIPT_DIR/omni-send" "$fpath"
      ;;
    y|Y)
      echo -e "${C_CYAN}[*] Pushing phone-hub updates to phone...${C_RESET}"
      scp -P "$PHONE_PORT" -r "$SCRIPT_DIR"/* "${PHONE_USER}@${PHONE_IP}:~/bin/" 2>/dev/null && \
        echo -e "${C_GREEN}[✓] Phone updated from Desktop!${C_RESET}" || echo -e "${C_RED}[!] Push failed.${C_RESET}"
      ;;
    l|L) ssh -o ConnectTimeout=3 -t "${LAPTOP_USER}@${LAPTOP_IP}" ;;
    t|T) [ -f "$HOME/.local/bin/desk-status" ] && "$HOME/.local/bin/desk-status" || htop ;;
    u|U) nvidia-smi --query-gpu=name,utilization.gpu,memory.used,memory.total,temperature.gpu --format=csv,noheader ;;
    k|K) loginctl lock-session 2>/dev/null || hyprctl dispatch exit 2>/dev/null || true ;;
    s|S) exit 0 ;;
    e|E|q|Q|0) exit 0 ;;
    *) echo "Invalid option." ; sleep 0.8 ;;
  esac
  echo ""
  read -rp "Press Enter to continue..." _
done
