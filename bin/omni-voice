#!/usr/bin/env bash
# ==============================================================================
#  OMNI VOICE — Interactive Voice-to-AI Assistant for S24 Phone
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/omni-core.sh"

CURRENT_DEV=$(omni_detect_device)
if [ "$CURRENT_DEV" != "phone" ]; then
  echo -e "${C_RED}[!] Voice assistant is designed for Android Termux with microphone access.${C_RESET}"
  exit 1
fi

echo -e "${C_CYAN}🎙️  Listening... Speak your prompt now into your S24 microphone.${C_RESET}"
QUERY=$(termux-speech-to-text 2>/dev/null || true)

if [ -z "$QUERY" ]; then
  echo -e "${C_YELLOW}[!] No voice input detected.${C_RESET}"
  exit 0
fi

echo -e "\n${C_BOLD}You said:${C_RESET} \"$QUERY\""
echo -e "${C_CYAN}[*] Processing with Copilot...${C_RESET}\n"

# Run through ask or Desktop Copilot
if [ -f "$HOME/bin/ask" ]; then
  RESPONSE=$("$HOME/bin/ask" "$QUERY" 2>&1)
elif [ -n "$DESKTOP_IP" ] && omni_is_online "$DESKTOP_IP"; then
  echo -e "${C_CYAN}[*] Routing query to Desktop GPU AI...${C_RESET}"
  RESPONSE=$(ssh -o ConnectTimeout=4 "${DESKTOP_USER}@${DESKTOP_IP}" "agy '$QUERY' 2>/dev/null || claude -p '$QUERY' 2>/dev/null" || echo "Desktop AI response unavailable.")
else
  RESPONSE="Copilot is offline."
fi

echo "$RESPONSE"

# Read aloud summary via TTS
CLEAN_TEXT=$(echo "$RESPONSE" | sed 's/\x1b\[[0-9;]*m//g' | head -n 4)
if [ -n "$CLEAN_TEXT" ]; then
  echo -n "$CLEAN_TEXT" | termux-tts-speak 2>/dev/null || true
fi

echo ""
echo -e "Navigation: [b] Back to OMNI Menu  |  [Enter / q] Exit to Shell"
read -rsn1 -p "Select action: " v_nav
echo ""
[[ "$v_nav" =~ ^[bB]$ ]] && exec omni
exit 0
