#!/usr/bin/env bash
# ==============================================================================
#  OMNI SEND — Universal 3-Way File & Folder Transfer Engine
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/omni-core.sh"

ITEM="${1:-}"
if [ -z "$ITEM" ] || [ "$ITEM" = "-h" ] || [ "$ITEM" = "--help" ]; then
  echo -e "${C_CYAN}Usage:${C_RESET} omni send <file_or_dir> [target]"
  echo "Targets: --phone, --laptop, --desktop, --windows, --mac"
  echo "Ad-Hoc / Non-Fleet:"
  echo "  omni send <file> --share      (Instant local QR-code / browser download for iOS/Android/PC)"
  echo "  omni send <file> --public     (Worldwide public HTTPS link via Tailscale Funnel)"
  exit 0
fi

if [ "$2" = "--share" ] || [ "$2" = "-s" ] || [ "$1" = "--share" ]; then
  shift
  exec "$SCRIPT_DIR/omni-share" "$@"
fi

if [ "$2" = "--public" ] || [ "$2" = "-p" ]; then
  exec "$SCRIPT_DIR/omni-share" "$ITEM" --public
fi

if [ ! -e "$ITEM" ]; then
  echo -e "${C_RED}[!] Error: File or directory '$ITEM' not found.${C_RESET}"
  exit 1
fi

BASENAME=$(basename "$ITEM")
CURRENT_DEV=$(omni_detect_device)
TARGET="${2:-}"

# Interactive Destination Prompt if not specified
if [ -z "$TARGET" ]; then
  echo -e "${C_CYAN}Sending '${BASENAME}'... Choose destination:${C_RESET}"
  case "$CURRENT_DEV" in
    desktop)
      echo -e "  ${C_GREEN}[1]${C_RESET} 📱 Phone (${PHONE_DOWNLOADS})"
      echo -e "  ${C_GREEN}[2]${C_RESET} 💻 Laptop (${LAPTOP_DOWNLOADS})"
      read -r -p "Target [1-2]: " dest_choice
      [ "$dest_choice" = "1" ] && TARGET="phone"
      [ "$dest_choice" = "2" ] && TARGET="laptop"
      ;;
    laptop)
      echo -e "  ${C_GREEN}[1]${C_RESET} 🖥️  Desktop (${DESKTOP_DOWNLOADS})"
      echo -e "  ${C_GREEN}[2]${C_RESET} 📱 Phone (${PHONE_DOWNLOADS})"
      echo -e "  ${C_GREEN}[3]${C_RESET} 🪟 Windows PC (${WINDOWS_DOWNLOADS:-C:/Users/.../Downloads})"
      read -r -p "Target [1-3]: " dest_choice
      [ "$dest_choice" = "1" ] && TARGET="desktop"
      [ "$dest_choice" = "2" ] && TARGET="phone"
      [ "$dest_choice" = "3" ] && TARGET="windows"
      ;;
    phone)
      echo -e "  ${C_GREEN}[1]${C_RESET} 🖥️  Desktop (${DESKTOP_DOWNLOADS})"
      echo -e "  ${C_GREEN}[2]${C_RESET} 💻 Laptop (${LAPTOP_DOWNLOADS})"
      echo -e "  ${C_GREEN}[3]${C_RESET} 🪟 Windows PC (${WINDOWS_DOWNLOADS:-C:/Users/.../Downloads})"
      read -r -p "Target [1-3]: " dest_choice
      [ "$dest_choice" = "1" ] && TARGET="desktop"
      [ "$dest_choice" = "2" ] && TARGET="laptop"
      [ "$dest_choice" = "3" ] && TARGET="windows"
      ;;
    desktop|wsl|*)
      echo -e "  ${C_GREEN}[1]${C_RESET} 📱 Phone (${PHONE_DOWNLOADS})"
      echo -e "  ${C_GREEN}[2]${C_RESET} 💻 Laptop (${LAPTOP_DOWNLOADS})"
      echo -e "  ${C_GREEN}[3]${C_RESET} 🪟 Windows PC (${WINDOWS_DOWNLOADS:-C:/Users/.../Downloads})"
      read -r -p "Target [1-3]: " dest_choice
      [ "$dest_choice" = "1" ] && TARGET="phone"
      [ "$dest_choice" = "2" ] && TARGET="laptop"
      [ "$dest_choice" = "3" ] && TARGET="windows"
      ;;
  esac
fi

case "$TARGET" in
  --phone|phone|mobile) DEST="phone" ;;
  --laptop|laptop|lap) DEST="laptop" ;;
  --desktop|desktop|desk) DEST="desktop" ;;
  --windows|windows|pc|win) DEST="windows" ;;
  --mac|mac|macos|apple) DEST="mac" ;;
  *) echo -e "${C_RED}[!] Invalid destination: $TARGET${C_RESET}"; exit 1 ;;
esac

echo -e "\n${C_CYAN}[*] Transferring '$BASENAME' to $DEST...${C_RESET}"

case "$DEST" in
  phone)
    if ! omni_is_online "$PHONE_IP"; then
      echo -e "${C_RED}[!] Phone is unreachable ($PHONE_IP).${C_RESET}"
      exit 1
    fi
    scp -P "$PHONE_PORT" -r "$ITEM" "${PHONE_USER}@${PHONE_IP}:${PHONE_DOWNLOADS}/" && {
      echo -e "${C_GREEN}[✓] Successfully sent to Phone Downloads!${C_RESET}"
      ssh -p "$PHONE_PORT" "${PHONE_USER}@${PHONE_IP}" "termux-notification --title 'OMNI File Received' --content '$BASENAME saved to Downloads' 2>/dev/null" || true
    }
    ;;
  desktop)
    if ! omni_is_online "$DESKTOP_IP"; then
      echo -e "${C_RED}[!] Desktop is unreachable ($DESKTOP_IP).${C_RESET}"
      exit 1
    fi
    scp -r "$ITEM" "${DESKTOP_USER}@${DESKTOP_IP}:${DESKTOP_DOWNLOADS}/" && {
      echo -e "${C_GREEN}[✓] Successfully sent to Desktop!${C_RESET}"
      ssh "${DESKTOP_USER}@${DESKTOP_IP}" "DISPLAY=:0 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus notify-send 'OMNI File Received' '$BASENAME saved to Downloads' 2>/dev/null" || true
    }
    ;;
  laptop)
    if ! omni_is_online "$LAPTOP_IP"; then
      echo -e "${C_RED}[!] Laptop is unreachable ($LAPTOP_IP).${C_RESET}"
      exit 1
    fi
    scp -r "$ITEM" "${LAPTOP_USER}@${LAPTOP_IP}:${LAPTOP_DOWNLOADS}/" && {
      echo -e "${C_GREEN}[✓] Successfully sent to Laptop!${C_RESET}"
      ssh "${LAPTOP_USER}@${LAPTOP_IP}" "DISPLAY=:0 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus notify-send 'OMNI File Received' '$BASENAME saved to Downloads' 2>/dev/null" || true
    }
    ;;
  windows)
    if [ -z "${WINDOWS_IP:-}" ] || ! omni_is_online "$WINDOWS_IP"; then
      echo -e "${C_RED}[!] Windows PC is unreachable (${WINDOWS_IP:-not configured}).${C_RESET}"
      exit 1
    fi
    win_dest="${WINDOWS_DOWNLOADS:-C:/Users/${WINDOWS_USER:-jpi}/Downloads}"
    scp -r "$ITEM" "${WINDOWS_USER:-jpi}@${WINDOWS_IP}:${win_dest}/" && {
      echo -e "${C_GREEN}[✓] Successfully sent to Windows Downloads!${C_RESET}"
    }
    ;;
  mac)
    if [ -z "${MAC_IP:-}" ] || ! omni_is_online "$MAC_IP"; then
      echo -e "${C_RED}[!] Mac is unreachable (${MAC_IP:-not configured}).${C_RESET}"
      exit 1
    fi
    mac_dest="${MAC_DOWNLOADS:-/Users/${MAC_USER:-$USER}/Downloads}"
    scp -r "$ITEM" "${MAC_USER:-$USER}@${MAC_IP}:${mac_dest}/" && {
      echo -e "${C_GREEN}[✓] Successfully sent to Mac Downloads!${C_RESET}"
      ssh "${MAC_USER:-$USER}@${MAC_IP}" "osascript -e 'display notification \"$BASENAME saved to Downloads\" with title \"OMNI File Received\"' 2>/dev/null" || true
    }
    ;;
esac
