#!/usr/bin/env bash
# OMNI Shell Launcher
# Opens directly with prompt: hitting Enter goes directly to the shell, or select dashboard option

# Avoid running in subshells, scripts, or non-interactive sessions
[[ $- != *i* ]] && return 2>/dev/null || true

C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_BOLD="\033[1m"
C_DIM="\033[2m"
C_RESET="\033[0m"

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omni"
mkdir -p "$CACHE_DIR" 2>/dev/null

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/omni/config.env"
if [ -f "$CONFIG_FILE" ]; then
  # shellcheck source=/dev/null
  source "$CONFIG_FILE"
fi

PHONE_IP="${PHONE_IP:-127.0.0.1}"
LAPTOP_IP="${LAPTOP_IP:-127.0.0.1}"
DESKTOP_IP="${DESKTOP_IP:-127.0.0.1}"

LOCAL_HOST=$(hostname)
PEER_NAME="Desktop"
PEER_IP="$DESKTOP_IP"
if [[ "$LOCAL_HOST" =~ "desktop" ]]; then
  PEER_NAME="Laptop"
  PEER_IP="$LAPTOP_IP"
fi

CACHE_FILE="$CACHE_DIR/status_cache"
NOW=$(date +%s)
p_stat="${C_GREEN}online${C_RESET}"
peer_stat="${C_GREEN}online${C_RESET}"

if [ -f "$CACHE_FILE" ]; then
  # shellcheck source=/dev/null
  source "$CACHE_FILE"
fi

if [ -z "${STATUS_TIMESTAMP:-}" ] || [ $((NOW - STATUS_TIMESTAMP)) -ge 30 ]; then
  (
    p_ok=0; peer_ok=0
    ping -c 1 -W 1 "$PHONE_IP" >/dev/null 2>&1 && p_ok=1
    ping -c 1 -W 1 "$PEER_IP" >/dev/null 2>&1 && peer_ok=1
    cat << STAT > "$CACHE_FILE.tmp"
STATUS_TIMESTAMP=$NOW
CACHE_P_OK=$p_ok
CACHE_PEER_OK=$peer_ok
STAT
    mv -f "$CACHE_FILE.tmp" "$CACHE_FILE"
  ) >/dev/null 2>&1 &
fi

[ "${CACHE_P_OK:-1}" = "1" ] && p_stat="${C_GREEN}online${C_RESET}" || p_stat="${C_RED}offline${C_RESET}"
[ "${CACHE_PEER_OK:-1}" = "1" ] && peer_stat="${C_GREEN}online${C_RESET}" || peer_stat="${C_RED}offline${C_RESET}"

cols=$(tput cols 2>/dev/null || echo "${COLUMNS:-80}")
[ -z "$cols" ] || [ "$cols" -le 0 ] && cols=80

if [ "$cols" -ge 65 ]; then
  echo -e "${C_CYAN}${C_BOLD}  ___  __  __ _   _ ___${C_RESET}   ${C_BOLD}OMNI System Control${C_RESET} ${C_YELLOW}v1.3.0${C_RESET}"
  echo -e "${C_CYAN}${C_BOLD} / _ \|  \/  | \ | |_ _|${C_RESET}  ${C_DIM}Host:${C_RESET} $(hostname) │ ${C_DIM}Phone:${C_RESET} $p_stat │ ${C_DIM}${PEER_NAME}:${C_RESET} $peer_stat"
  echo -e "${C_CYAN}${C_BOLD}| |_| | |  | | |\  || |${C_RESET}   ${C_BOLD}[Enter]${C_RESET} ➔ Drop directly to Shell │ ${C_BOLD}'menu'${C_RESET} or ${C_BOLD}'m'${C_RESET} ➔ Dashboard"
  echo -e "${C_CYAN}${C_BOLD} \___/|_|  |_|_| \_|___|${C_RESET}"
else
  echo -e "${C_CYAN}${C_BOLD}⚡ OMNI System Control${C_RESET} ${C_YELLOW}v1.3.0${C_RESET}"
  echo -e " ${C_DIM}Host:${C_RESET} $(hostname) │ ${C_DIM}Phone:${C_RESET} $p_stat │ ${C_DIM}${PEER_NAME}:${C_RESET} $peer_stat"
  echo -e " ${C_BOLD}[Enter]${C_RESET} ➔ Shell │ ${C_BOLD}'m'${C_RESET} ➔ Dashboard"
fi
echo ""

read -r -t 10 -p $'\033[1;36mOMNI ❯ \033[0m' user_act || user_act=""

case "$user_act" in
  ""|s|shell)
    # Hitting enter goes directly to shell
    ;;
  m|menu|omni)
    omni
    ;;
  *)
    if [ -n "$user_act" ]; then
      eval "$user_act"
    fi
    ;;
esac
