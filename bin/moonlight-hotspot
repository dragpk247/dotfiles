#!/usr/bin/env bash
# moonlight-hotspot: Wrapper with data saver nudge for cellular/hotspot sessions

C_CYAN="\033[1;36m"
C_YELLOW="\033[1;33m"
C_GREEN="\033[1;32m"
C_BOLD="\033[1m"
C_DIM="\033[2m"
C_RESET="\033[0m"

echo -e "\n${C_YELLOW}${C_BOLD}⚠️  Data-Saver Advisory (Moonlight Stream)${C_RESET}"
echo -e "Moonlight consumes ${C_BOLD}~3.6 GB to 4.5 GB/hr${C_RESET} at 8 Mbps."
echo -e "Remote Antigravity consumes ${C_BOLD}< 20 MB/hr${C_RESET} (${C_GREEN}~99.5% data savings${C_RESET}).\n"
echo -e "  ${C_GREEN}[1] 🤖 Launch Remote Antigravity${C_RESET} ${C_DIM}(Save data & battery - recommended)${C_RESET}"
echo -e "  ${C_CYAN}[2] 🖥️  Proceed with Moonlight Streaming${C_RESET} ${C_DIM}(Full GUI display)${C_RESET}"
echo -e "  ${C_DIM}[q] Cancel back to shell${C_RESET}\n"

read -rsn1 -p "Select option [1=Antigravity, 2=Moonlight, q=Cancel]: " choice
echo ""

case "$choice" in
  1|"")
    echo -e "${C_GREEN}[*] Launching Remote Antigravity session on Desktop...${C_RESET}"
    if [ -f "$HOME/dotfiles/bin/omni-core.sh" ]; then
      source "$HOME/dotfiles/bin/omni-core.sh"
    fi
    DESKTOP_IP="${DESKTOP_IP:-100.86.159.86}"
    DESKTOP_USER="${DESKTOP_USER:-jpi}"
    exec ssh -o ConnectTimeout=3 -t "${DESKTOP_USER}@${DESKTOP_IP}" "/home/${DESKTOP_USER}/ap"
    ;;
  2)
    echo -e "${C_CYAN}[*] Starting Moonlight stream (1920x1200 @ 120fps, 8Mbps)...${C_RESET}"
    exec moonlight stream \
      --resolution 1920x1200 \
      --fps 120 \
      --bitrate 8000 \
      --video-codec H.264 \
      --video-decoder hardware \
      --no-vsync \
      --no-frame-pacing \
      --absolute-mouse \
      --display-mode fullscreen \
      --capture-system-keys always \
      100.86.159.86 "Desktop"
    ;;
  q|Q)
    echo -e "${C_DIM}Cancelled.${C_RESET}"
    exit 0
    ;;
  *)
    echo -e "${C_YELLOW}Unrecognized choice. Cancelling.${C_RESET}"
    exit 0
    ;;
esac
