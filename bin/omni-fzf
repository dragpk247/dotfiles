#!/usr/bin/env bash
# ==============================================================================
#  OMNI FZF — Interactive Fuzzy Action Launcher
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/omni-core.sh"

if ! command -v fzf >/dev/null 2>&1; then
  echo -e "${C_YELLOW}[!] fzf is not installed. Falling back to regular menu.${C_RESET}"
  exec "$SCRIPT_DIR/omni"
fi

CURRENT_DEV=$(omni_detect_device)

declare -A ACTIONS

case "$CURRENT_DEV" in
  phone)
    ACTIONS["[s] 🐚 Local Phone Shell (${PHONE_IP:-127.0.0.1})"]="${SHELL:-bash} -l"
    ACTIONS["[1] 🤖 Ask Copilot (Desktop GPU / Fallback)"]="omni ask"
    ACTIONS["[2] 🎙️ Voice Assistant (Speak Prompt)"]="omni voice"
    ACTIONS["[3] 📋 Send Clipboard to AI (clip-ask)"]="omni clip-ask"
    ACTIONS["[4] ⚡ Run Clipboard Command (clip-run)"]="omni clip-run"
    ACTIONS["[5] 📓 Ingest Clip to Note (Obsidian)"]="omni-phone"
    ACTIONS["[6] 📋 Cross-Device Clipboard Sync"]="omni clip"
    ACTIONS["[7] 📁 3-Way File Send (Desktop/Laptop)"]="omni send"
    ACTIONS["[8] 🛡️ Check Battery Sentinel (guard)"]="omni guard"
    ACTIONS["[9] 🔔 Toggle Background Wake-Lock"]="omni-phone"
    ACTIONS["[10] 🚀 Connect Desktop Antigravity (agy)"]="omni agy"
    ACTIONS["[11] 🟣 Connect Desktop Claude Code"]="omni claude"
    ACTIONS["[12] 💻 Connect Desktop Aider Pair Programmer"]="omni aider"
    ACTIONS["[13] ⚡ Connect Desktop Jev Router Chat"]="omni jev"
    ACTIONS["[14] 🎵 Desktop Media & Volume Control"]="omni-phone"
    ACTIONS["[15] 📊 View Desktop Health Monitor (top)"]="omni top"
    ACTIONS["[16] 🎮 View Desktop RTX 5070 Ti GPU"]="omni gpu"
    ACTIONS["[17] 🔒 Lock Desktop Screen"]="omni lock"
    ACTIONS["[18] ⚡ Wake Desktop (Wake-on-LAN)"]="omni-phone"
    ACTIONS["[19] 💻 SSH Shell into Arch Laptop (${LAPTOP_IP:-unknown})"]="omni laptop"
    ACTIONS["[20] 🖥️ SSH Shell into Desktop (${DESKTOP_IP:-unknown})"]="ssh -o ConnectTimeout=3 -t ${DESKTOP_USER}@${DESKTOP_IP}"
    ACTIONS["[21] 🔄 Pull Config Updates (sync-down)"]="sync-down"
    ACTIONS["[22] 🧪 Sandbox / Mock Playground"]="omni mock"
    ;;
  laptop)
    ACTIONS["[s] 🐚 Local Laptop Shell (${LAPTOP_IP:-127.0.0.1})"]="${SHELL:-bash} -l"
    ACTIONS["[1] 🖥️ Moonlight Stream Fullscreen"]="omni stream"
    ACTIONS["[2] 🖥️ Moonlight Stream Windowed"]="omni stream-win"
    ACTIONS["[3] 🤖 Remote Desktop Antigravity (agy)"]="omni agy"
    ACTIONS["[4] 🚀 Local Laptop Antigravity (agy)"]="omni local-agy"
    ACTIONS["[5] 🟣 Remote Desktop Claude Code"]="omni claude"
    ACTIONS["[6] 💻 Remote Desktop Aider Programmer"]="omni aider"
    ACTIONS["[7] ⚡ Remote Desktop Jev Router"]="omni jev"
    ACTIONS["[8] 💻 Desktop SSH Terminal Session (${DESKTOP_IP:-unknown})"]="ssh -t ${DESKTOP_USER}@${DESKTOP_IP}"
    ACTIONS["[9] 📱 Phone Termux SSH Shell (${PHONE_IP:-unknown})"]="omni phone"
    ACTIONS["[10] 📱 Phone Screen Mirror (scrcpy)"]="omni mirror"
    ACTIONS["[11] 📱 Ring/Ping Phone via Termux"]="omni-laptop"
    ACTIONS["[12] 📁 3-Way File Send (Desktop/Phone)"]="omni send"
    ACTIONS["[13] 📋 Cross-Device Clipboard Sync"]="omni clip"
    ACTIONS["[14] 🎵 Desktop Remote Media / Volume"]="omni-laptop"
    ACTIONS["[15] ⚡ Wake Desktop (Wake-on-LAN)"]="omni-laptop"
    ACTIONS["[16] 📊 View Desktop System Health"]="omni top"
    ACTIONS["[17] 🎮 View Desktop RTX 5070 Ti GPU"]="omni gpu"
    ACTIONS["[18] 🔒 Lock Desktop Screen"]="omni lock"
    ACTIONS["[19] 🔄 Git Pull Dotfiles"]="omni-laptop"
    ACTIONS["[20] 🧪 Sandbox / Mock Playground"]="omni mock"
    ;;
  desktop)
    ACTIONS["[s] 🐚 Local Desktop Shell (${DESKTOP_IP:-127.0.0.1})"]="${SHELL:-bash} -l"
    ACTIONS["[1] 🤖 Local Antigravity (agy tmux)"]="omni agy"
    ACTIONS["[2] 🟣 Local Claude Code (claude tmux)"]="omni claude"
    ACTIONS["[3] 💻 Local Aider Programmer (aider tmux)"]="omni aider"
    ACTIONS["[4] 🕊️ Local Hermes Agent"]="tmux attach -t hermes 2>/dev/null || tmux new-session -s hermes 'hermes chat'"
    ACTIONS["[5] ⚡ Local Jev Router Chat"]="omni jev"
    ACTIONS["[6] 🪟 Jump to Hyprland Window (Active Clients)"]="omni-desktop"
    ACTIONS["[7] 📓 Ingest Clip to Note (Obsidian)"]="omni-desktop"
    ACTIONS["[8] 🎵 Media & Volume Control (playerctl/pipewire)"]="omni-desktop"
    ACTIONS["[9] ⚡ System Power Profile (perf/balanced/saver)"]="omni-desktop"
    ACTIONS["[10] 📱 Phone Remote Hub (Vibrate, URL, Camera, SMS)"]="omni-desktop"
    ACTIONS["[11] 📱 Phone Termux SSH Shell (${PHONE_IP:-unknown})"]="omni phone"
    ACTIONS["[12] 📱 Phone Screen Mirror (scrcpy)"]="omni mirror"
    ACTIONS["[13] 💻 SSH Shell into Arch Laptop (${LAPTOP_IP:-unknown})"]="omni laptop"
    ACTIONS["[14] 📁 3-Way File Send (Phone/Laptop)"]="omni send"
    ACTIONS["[15] 📋 Cross-Device Clipboard Sync"]="omni clip"
    ACTIONS["[16] 🔔 Send Push Notification to S24"]="omni notify"
    ACTIONS["[17] 📊 System Health Monitor (htop)"]="omni top"
    ACTIONS["[18] 🎮 NVIDIA RTX 5070 Ti Telemetry"]="omni gpu"
    ACTIONS["[19] 🔒 Lock Desktop Screen"]="omni lock"
    ACTIONS["[20] 📤 Push Updates to Phone"]="omni-desktop"
    ACTIONS["[21] 🧪 Sandbox / Mock Playground"]="omni mock"
    ;;
esac

CHOICE=$(printf "%s\n" "${!ACTIONS[@]}" | sort -V | fzf --prompt="OMNI ($CURRENT_DEV) ❯ " --height=50% --layout=reverse --border)

if [ -n "$CHOICE" ]; then
  CMD="${ACTIONS[$CHOICE]}"
  echo -e "${C_CYAN}==> Executing: $CMD${C_RESET}"
  eval "$CMD"
fi
