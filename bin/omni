#!/usr/bin/env bash
# ==============================================================================
#  OMNI CLI — Unified Multi-Device Command & Control Center
#  Supports: Desktop (omarchy-desktop) | Laptop (jordanslaptop) | Phone (S24 Termux)
# ==============================================================================

set -uo pipefail

DESKTOP_TAILSCALE_IP="100.86.159.86"
DESKTOP_HOST="jordansdesktop"
DESKTOP_MAC="34:5a:60:b6:62:e1"

LAPTOP_TAILSCALE_IP="100.72.213.23"
LAPTOP_HOST="jordanslaptop"

PHONE_TAILSCALE_IP="100.118.50.88"
PHONE_SSH_PORT="8022"
PHONE_SSH_USER="u0_a501"

# Terminal Colors
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_RED="\033[1;31m"
C_YELLOW="\033[1;33m"
C_BLUE="\033[1;34m"
C_MAGENTA="\033[1;35m"
C_DIM="\033[2m"

# ── Device Detection ──
detect_device() {
  if [ -n "${TERMUX_VERSION:-}" ] || [ -d "/data/data/com.termux" ]; then
    echo "phone"
  elif [[ "$(hostname)" =~ (laptop|jordanslaptop) ]] || { [ -d "/sys/class/power_supply/BAT0" ] && [ "$(hostname)" != "omarchy-desktop" ]; }; then
    echo "laptop"
  else
    echo "desktop"
  fi
}

CURRENT_DEVICE=$(detect_device)

# ── Device Pings ──
is_host_online() {
  local ip="$1"
  ping -c 1 -W 1 "$ip" >/dev/null 2>&1
}

# ── Banner ──
show_header() {
  clear
  echo -e "${C_CYAN}"
  cat << "BANNER"
  ___  __  __ _   _ ___   ____ _     ___ 
 / _ \|  \/  | \ | |_ _| / ___| |   |_ _|
| | | | |\/| |  \| || | | |   | |    | | 
| |_| | |  | | |\  || | | |___| |___ | | 
 \___/|_|  |_|_| \_|___| \____|_____|___|
BANNER
  echo -e "${C_RESET}${C_DIM}─────────────────────────────────────────────────────────────────${C_RESET}"
  
  case "$CURRENT_DEVICE" in
    phone)
      local b_stat
      b_stat=$(termux-battery-status 2>/dev/null | jq -r '"\(.percentage)% (\(if .plugged == "PLUGGED_AC" then "⚡" else "🔋" end))"' 2>/dev/null || echo "?")
      local d_stat="${C_RED}Offline${C_RESET}"
      local l_stat="${C_RED}Offline${C_RESET}"
      is_host_online "$DESKTOP_TAILSCALE_IP" && d_stat="${C_GREEN}Online${C_RESET}"
      is_host_online "$LAPTOP_TAILSCALE_IP" && l_stat="${C_GREEN}Online${C_RESET}"
      echo -e " ${C_BOLD}OMNI Mobile (S24)${C_RESET} │ ${C_BOLD}Battery:${C_RESET} $b_stat │ ${C_BOLD}Desktop:${C_RESET} $d_stat │ ${C_BOLD}Laptop:${C_RESET} $l_stat"
      ;;
    desktop)
      local p_stat="${C_RED}Offline${C_RESET}"
      local l_stat="${C_RED}Offline${C_RESET}"
      is_host_online "$PHONE_TAILSCALE_IP" && p_stat="${C_GREEN}Online${C_RESET}"
      is_host_online "$LAPTOP_TAILSCALE_IP" && l_stat="${C_GREEN}Online${C_RESET}"
      echo -e " ${C_BOLD}OMNI Desktop${C_RESET} │ ${C_BOLD}Host:${C_RESET} $(hostname) │ ${C_BOLD}Phone:${C_RESET} $p_stat │ ${C_BOLD}Laptop:${C_RESET} $l_stat"
      ;;
    laptop)
      local d_stat="${C_RED}Offline${C_RESET}"
      local p_stat="${C_RED}Offline${C_RESET}"
      is_host_online "$DESKTOP_TAILSCALE_IP" && d_stat="${C_GREEN}Online${C_RESET}"
      is_host_online "$PHONE_TAILSCALE_IP" && p_stat="${C_GREEN}Online${C_RESET}"
      echo -e " ${C_BOLD}OMNI Laptop${C_RESET} │ ${C_BOLD}Host:${C_RESET} $(hostname) │ ${C_BOLD}Desktop:${C_RESET} $d_stat │ ${C_BOLD}Phone:${C_RESET} $p_stat"
      ;;
  esac
  echo -e "${C_DIM}─────────────────────────────────────────────────────────────────${C_RESET}"
}

# ── Actions ──

action_agy() {
  if [ "$CURRENT_DEVICE" = "desktop" ]; then
    /home/jpi/ap
  else
    ssh -o ConnectTimeout=3 -t jpi@$DESKTOP_TAILSCALE_IP "/home/jpi/ap"
  fi
}

action_claude() {
  if [ "$CURRENT_DEVICE" = "desktop" ]; then
    /home/jpi/.local/bin/claude-phone
  else
    ssh -o ConnectTimeout=3 -t jpi@$DESKTOP_TAILSCALE_IP "/home/jpi/.local/bin/claude-phone"
  fi
}

action_aider() {
  if [ "$CURRENT_DEVICE" = "desktop" ]; then
    /home/jpi/.local/bin/aider-phone
  else
    ssh -o ConnectTimeout=3 -t jpi@$DESKTOP_TAILSCALE_IP "/home/jpi/.local/bin/aider-phone"
  fi
}

action_jev() {
  local prompt="${*:-}"
  if [ "$CURRENT_DEVICE" = "desktop" ]; then
    if [ -n "$prompt" ]; then
      /home/jpi/.local/bin/jev-chat "$prompt"
    else
      /home/jpi/.local/bin/jev-chat
    fi
  else
    if [ -n "$prompt" ]; then
      ssh -o ConnectTimeout=3 -t jpi@$DESKTOP_TAILSCALE_IP "/home/jpi/.local/bin/jev-chat '$prompt'"
    else
      ssh -o ConnectTimeout=3 -t jpi@$DESKTOP_TAILSCALE_IP "/home/jpi/.local/bin/jev-chat"
    fi
  fi
}

action_phone_ssh() {
  if [ "$CURRENT_DEVICE" = "phone" ]; then
    echo "Already on phone."
  else
    echo -e "${C_GREEN}[+] Connecting to S24 Termux shell...${C_RESET}"
    ssh -p "$PHONE_SSH_PORT" "${PHONE_SSH_USER}@${PHONE_TAILSCALE_IP}"
  fi
}

action_phone_mirror() {
  if [ "$CURRENT_DEVICE" = "phone" ]; then
    echo "Cannot mirror phone from inside phone."
  else
    if ! command -v scrcpy >/dev/null 2>&1; then
      echo -e "${C_RED}[!] scrcpy not installed.${C_RESET}"
      return 1
    fi
    echo -e "${C_CYAN}[*] Connecting scrcpy to S24...${C_RESET}"
    adb connect "${PHONE_TAILSCALE_IP}:5555" 2>/dev/null || true
    scrcpy --stay-awake --turn-screen-off || scrcpy
  fi
}

action_laptop_ssh() {
  echo -e "${C_GREEN}[+] Connecting to Laptop shell...${C_RESET}"
  ssh -o ConnectTimeout=3 -t jpi@$LAPTOP_TAILSCALE_IP
}

action_desk_top() {
  if [ "$CURRENT_DEVICE" = "desktop" ]; then
    /home/jpi/.local/bin/desk-status 2>/dev/null || htop
  else
    ssh -o ConnectTimeout=3 -t jpi@$DESKTOP_TAILSCALE_IP "/home/jpi/.local/bin/desk-status"
  fi
}

action_desk_gpu() {
  if [ "$CURRENT_DEVICE" = "desktop" ]; then
    nvidia-smi --query-gpu=name,utilization.gpu,memory.used,memory.total,temperature.gpu --format=csv,noheader
  else
    ssh -o ConnectTimeout=3 jpi@$DESKTOP_TAILSCALE_IP "nvidia-smi --query-gpu=name,utilization.gpu,memory.used,memory.total,temperature.gpu --format=csv,noheader"
  fi
}

action_desk_lock() {
  if [ "$CURRENT_DEVICE" = "desktop" ]; then
    loginctl lock-session 2>/dev/null || hyprctl dispatch exit 2>/dev/null || true
  else
    ssh -o ConnectTimeout=3 jpi@$DESKTOP_TAILSCALE_IP "loginctl lock-session 2>/dev/null || hyprctl dispatch exit 2>/dev/null || true"
  fi
  echo -e "${C_GREEN}[✓] Desktop screen locked.${C_RESET}"
}

action_desk_logs() {
  if [ "$CURRENT_DEVICE" = "desktop" ]; then
    tail -f /home/jpi/.local/share/obsidian-ai-router/server.log 2>/dev/null || tail -f /tmp/jev.log 2>/dev/null
  else
    ssh -o ConnectTimeout=3 -t jpi@$DESKTOP_TAILSCALE_IP "tail -f /home/jpi/.local/share/obsidian-ai-router/server.log 2>/dev/null || tail -f /tmp/jev.log 2>/dev/null"
  fi
}

action_sync() {
  case "$CURRENT_DEVICE" in
    phone)
      sync-down
      ;;
    desktop)
      echo -e "${C_CYAN}[*] Pushing phone-hub updates to S24...${C_RESET}"
      scp -P "$PHONE_SSH_PORT" -r /home/jpi/phone-hub/bin/* "${PHONE_SSH_USER}@${PHONE_TAILSCALE_IP}:~/bin/" 2>/dev/null
      scp -P "$PHONE_SSH_PORT" /home/jpi/phone-hub/bashrc "${PHONE_SSH_USER}@${PHONE_TAILSCALE_IP}:~/.bashrc" 2>/dev/null && \
        echo -e "${C_GREEN}[✓] Phone updated from Desktop!${C_RESET}" || echo -e "${C_RED}[!] Push failed.${C_RESET}"
      ;;
    laptop)
      echo -e "${C_CYAN}[*] Pulling dotfiles from main git repo...${C_RESET}"
      cd "$HOME/dotfiles" && git pull --rebase origin main
      ;;
  esac
}

action_toggle_wakelock() {
  if [ "$CURRENT_DEVICE" != "phone" ]; then
    echo "Wake lock toggle is for phone only."
    return
  fi
  
  if [ -f "$PREFIX/var/run/wake-lock" ]; then
    termux-wake-unlock
    rm -f "$PREFIX/var/run/wake-lock"
    echo -e "${C_YELLOW}[!] Wake lock released. Notification should clear.${C_RESET}"
  else
    termux-wake-lock
    mkdir -p "$PREFIX/var/run"
    touch "$PREFIX/var/run/wake-lock"
    echo -e "${C_GREEN}[✓] Wake lock active. Background tasks protected.${C_RESET}"
  fi
}

# ── Menus ──

menu_phone() {
  while true; do
    show_header
    echo -e "${C_CYAN}${C_BOLD}  🧠 SMART COPILOT & CLIPBOARD (Phone-Native)${C_RESET}"
    echo -e "  ${C_CYAN}[1]${C_RESET} 🤖 Ask Copilot           (Desktop GPU / Local fallback)"
    echo -e "  ${C_CYAN}[2]${C_RESET} 📋 Send Clipboard to AI   (clip-ask)"
    echo -e "  ${C_CYAN}[3]${C_RESET} ⚡ Run Clipboard Command  (clip-run)"
    echo -e "  ${C_CYAN}[4]${C_RESET} 🛡️  Check Sentinel Guard   (guard)"
    echo -e "  ${C_CYAN}[w]${C_RESET} 🔔 Toggle Wake Lock      (Clear/keep notification)"
    echo ""
    echo -e "${C_GREEN}${C_BOLD}  🤖 REMOTE AI WORKSPACES (Desktop RTX 5070 Ti)${C_RESET}"
    echo -e "  ${C_CYAN}[5]${C_RESET} 🚀 Antigravity / Agy      (Desktop 'ai' session)"
    echo -e "  ${C_CYAN}[6]${C_RESET} 🟣 Claude Code            (Desktop 'claude' session)"
    echo -e "  ${C_CYAN}[7]${C_RESET} 💻 Aider Pair Programmer  (Desktop 'aider' session)"
    echo -e "  ${C_CYAN}[8]${C_RESET} ⚡ Jev Intelligent Router (Interactive chat)"
    echo ""
    echo -e "${C_YELLOW}${C_BOLD}  🖥️  DESKTOP TELEMETRY & CONTROLS${C_RESET}"
    echo -e "  ${C_CYAN}[t]${C_RESET} 📊 Desktop System Top     (CPU, RAM, GPU)"
    echo -e "  ${C_CYAN}[u]${C_RESET} 🎮 Desktop VRAM & GPU Temp"
    echo -e "  ${C_CYAN}[k]${C_RESET} 🔒 Lock Desktop Screen"
    echo -e "  ${C_CYAN}[l]${C_RESET} 💻 Laptop Terminal (SSH)"
    echo ""
    echo -e "${C_MAGENTA}${C_BOLD}  🔄 SYSTEM & MAINTENANCE${C_RESET}"
    echo -e "  ${C_CYAN}[y]${C_RESET} 🔄 Sync Updates from Desktop (sync-down)"
    echo -e "  ${C_CYAN}[s]${C_RESET} 🐚 Drop to Local Shell"
    echo -e "  ${C_RED}[e]${C_RESET} 🚪 Exit"
    echo ""
    read -r -p "Select option: " choice

    case "$choice" in
      1) read -r -p "Prompt: " p; [ -n "$p" ] && ~/bin/ask "$p" ;;
      2) ~/bin/clip-ask ;;
      3) ~/bin/clip-run ;;
      4) ~/bin/smart-guard.sh && echo -e "${C_GREEN}🛡️ Battery & Thermals: SAFE${C_RESET}" ;;
      w|W) action_toggle_wakelock ;;
      5) action_agy ;;
      6) action_claude ;;
      7) action_aider ;;
      8) action_jev ;;
      t|T) action_desk_top ;;
      u|U) action_desk_gpu ;;
      k|K) action_desk_lock ;;
      l|L) action_laptop_ssh ;;
      y|Y) action_sync ;;
      s|S) return 0 ;;
      e|E|q|Q|0) exit 0 ;;
      *) echo "Invalid option." ; sleep 0.8 ;;
    esac
    echo ""
    read -rp "Press Enter to continue..." _
  done
}

menu_desktop() {
  while true; do
    show_header
    echo -e "${C_CYAN}${C_BOLD}  🚀 LOCAL AI WORKSPACES (Desktop tmux)${C_RESET}"
    echo -e "  ${C_CYAN}[1]${C_RESET} 🤖 Antigravity / Agy      (Local 'ai' session)"
    echo -e "  ${C_CYAN}[2]${C_RESET} 🟣 Claude Code            (Local 'claude' session)"
    echo -e "  ${C_CYAN}[3]${C_RESET} 💻 Aider Pair Programmer  (Local 'aider' session)"
    echo -e "  ${C_CYAN}[4]${C_RESET} 🕊️  Hermes Agent           (Local 'hermes' session)"
    echo -e "  ${C_CYAN}[5]${C_RESET} ⚡ Jev Intelligent Router (Local router)"
    echo ""
    echo -e "${C_MAGENTA}${C_BOLD}  📱 S24 MOBILE PHONE (100.118.50.88)${C_RESET}"
    echo -e "  ${C_CYAN}[9]${C_RESET} 📱 Phone Termux SSH Shell (Port $PHONE_SSH_PORT)"
    echo -e "  ${C_CYAN}[0]${C_RESET} 📱 Phone Screen Mirror    (scrcpy)"
    echo -e "  ${C_CYAN}[y]${C_RESET} 📤 Push Hub Updates to Phone"
    echo ""
    echo -e "${C_YELLOW}${C_BOLD}  💻 LAPTOP & REMOTE (100.72.213.23)${C_RESET}"
    echo -e "  ${C_CYAN}[l]${C_RESET} 💻 Laptop SSH Shell"
    echo ""
    echo -e "${C_GREEN}${C_BOLD}  📊 TELEMETRY & CONTROLS${C_RESET}"
    echo -e "  ${C_CYAN}[t]${C_RESET} 📊 Local System Monitor   (htop / desk-top)"
    echo -e "  ${C_CYAN}[u]${C_RESET} 🎮 NVIDIA RTX 5070 Ti Top"
    echo -e "  ${C_CYAN}[k]${C_RESET} 🔒 Lock Desktop Screen"
    echo -e "  ${C_CYAN}[s]${C_RESET} 🐚 Drop to Local Shell"
    echo -e "  ${C_RED}[e]${C_RESET} 🚪 Exit"
    echo ""
    read -r -p "Select option: " choice

    case "$choice" in
      1) action_agy ;;
      2) action_claude ;;
      3) action_aider ;;
      4) tmux attach -t hermes 2>/dev/null || tmux new-session -s hermes 'hermes chat' ;;
      5) action_jev ;;
      9) action_phone_ssh ;;
      0) action_phone_mirror ;;
      y|Y) action_sync ;;
      l|L) action_laptop_ssh ;;
      t|T) action_desk_top ;;
      u|U) action_desk_gpu ;;
      k|K) action_desk_lock ;;
      s|S) return 0 ;;
      e|E|q|Q) exit 0 ;;
      *) echo "Invalid option." ; sleep 0.8 ;;
    esac
    echo ""
    read -rp "Press Enter to continue..." _
  done
}

menu_laptop() {
  while true; do
    show_header
    echo -e "${C_CYAN}${C_BOLD}  🖥️  DESKTOP REMOTE STREAMING & WORKSPACES${C_RESET}"
    echo -e "  ${C_CYAN}[1]${C_RESET} 🤖 Remote Antigravity     (Desktop 'ai' session)"
    echo -e "  ${C_CYAN}[2]${C_RESET} 🟣 Remote Claude Code     (Desktop 'claude' session)"
    echo -e "  ${C_CYAN}[3]${C_RESET} 💻 Remote Aider           (Desktop 'aider' session)"
    echo -e "  ${C_CYAN}[5]${C_RESET} ⚡ Remote Jev Chat"
    echo -e "  ${C_CYAN}[6]${C_RESET} 🖥️  Moonlight Stream Fullscreen"
    echo -e "  ${C_CYAN}[7]${C_RESET} 🖥️  Moonlight Stream Windowed"
    echo -e "  ${C_CYAN}[8]${C_RESET} 💻 Desktop SSH Terminal Session"
    echo ""
    echo -e "${C_MAGENTA}${C_BOLD}  📱 PHONE (Samsung S24 Termux)${C_RESET}"
    echo -e "  ${C_CYAN}[9]${C_RESET} 📱 Phone Termux SSH Shell"
    echo -e "  ${C_CYAN}[0]${C_RESET} 📱 Phone Screen Mirror (scrcpy)"
    echo ""
    echo -e "${C_YELLOW}${C_BOLD}  📊 TELEMETRY & CONTROLS${C_RESET}"
    echo -e "  ${C_CYAN}[t]${C_RESET} 📊 Desktop Health Monitor (CPU, RAM, GPU)"
    echo -e "  ${C_CYAN}[u]${C_RESET} 🎮 Desktop GPU Monitor"
    echo -e "  ${C_CYAN}[k]${C_RESET} 🔒 Lock Desktop Screen"
    echo -e "  ${C_CYAN}[s]${C_RESET} 🐚 Drop to Local Shell"
    echo -e "  ${C_RED}[e]${C_RESET} 🚪 Exit"
    echo ""
    read -r -p "Select option: " choice

    case "$choice" in
      1) action_agy ;;
      2) action_claude ;;
      3) action_aider ;;
      5) action_jev ;;
      6) moonlight stream "$DESKTOP_TAILSCALE_IP" "Desktop" ;;
      7) moonlight stream --display-mode windowed "$DESKTOP_TAILSCALE_IP" "Desktop" ;;
      8) ssh -t "$DESKTOP_HOST" ;;
      9) action_phone_ssh ;;
      0) action_phone_mirror ;;
      t|T) action_desk_top ;;
      u|U) action_desk_gpu ;;
      k|K) action_desk_lock ;;
      s|S) return 0 ;;
      e|E|q|Q) exit 0 ;;
      *) echo "Invalid option." ; sleep 0.8 ;;
    esac
    echo ""
    read -rp "Press Enter to continue..." _
  done
}

# ── Main Entry ──
case "${1:-}" in
  ""|menu)
    case "$CURRENT_DEVICE" in
      phone) menu_phone ;;
      desktop) menu_desktop ;;
      laptop) menu_laptop ;;
    esac
    ;;
  agy|desk-agy) action_agy ;;
  claude|desk-claude) action_claude ;;
  aider|desk-aider) action_aider ;;
  jev) shift; action_jev "$@" ;;
  phone) action_phone_ssh ;;
  mirror|phone-gui|scrcpy) action_phone_mirror ;;
  laptop|lap) action_laptop_ssh ;;
  desk-top|top) action_desk_top ;;
  desk-gpu|gpu) action_desk_gpu ;;
  desk-lock|lock) action_desk_lock ;;
  desk-logs|logs) action_desk_logs ;;
  sync|sync-down|sync-up) action_sync ;;
  wakelock|wake-lock) action_toggle_wakelock ;;
  ask)
    shift
    if [ "$CURRENT_DEVICE" = "phone" ]; then
      ~/bin/ask "$@"
    else
      echo "Ask copilot is on phone."
    fi
    ;;
  clip-ask)
    if [ "$CURRENT_DEVICE" = "phone" ]; then
      ~/bin/clip-ask
    fi
    ;;
  clip-run)
    if [ "$CURRENT_DEVICE" = "phone" ]; then
      ~/bin/clip-run
    fi
    ;;
  guard)
    if [ "$CURRENT_DEVICE" = "phone" ]; then
      ~/bin/smart-guard.sh && echo "🛡️ Battery & Thermals: SAFE"
    fi
    ;;
  *)
    echo "Unknown omni command: $1"
    echo "Usage: omni [menu|agy|claude|aider|jev|phone|mirror|laptop|top|gpu|lock|sync|wakelock]"
    exit 1
    ;;
esac
