#!/usr/bin/env bash
# ==============================================================================
#  OMNI — Hardware-Aware Multi-Device Command & Control Center
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/omni-core.sh" ]; then
  source "$SCRIPT_DIR/omni-core.sh"
elif [ -f "$HOME/.local/bin/omni-core.sh" ]; then
  source "$HOME/.local/bin/omni-core.sh"
elif [ -f "$HOME/bin/omni-core.sh" ]; then
  source "$HOME/bin/omni-core.sh"
fi

# Detect hardware
CURRENT_DEVICE=$(omni_detect_device)

case "${1:-}" in
  --phone|phone-ui)
    exec "$SCRIPT_DIR/omni-phone"
    ;;
  --laptop|laptop-ui)
    exec "$SCRIPT_DIR/omni-laptop"
    ;;
  --desktop|desktop-ui)
    exec "$SCRIPT_DIR/omni-desktop"
    ;;
  ""|menu)
    case "$CURRENT_DEVICE" in
      phone) exec "$SCRIPT_DIR/omni-phone" ;;
      laptop) exec "$SCRIPT_DIR/omni-laptop" ;;
      desktop) exec "$SCRIPT_DIR/omni-desktop" ;;
      *) exec "$SCRIPT_DIR/omni-desktop" ;;
    esac
    ;;
  help|-h|--help)
    echo "OMNI — Intelligent Multi-Device Command Center (Current: $CURRENT_DEVICE)"
    echo "Usage: omni [menu|--phone|--laptop|--desktop]"
    echo "       omni <direct-command> (e.g. omni ask, omni top, omni gpu, omni lock)"
    exit 0
    ;;
  send)
    shift
    exec "$SCRIPT_DIR/omni-send" "$@"
    ;;
  # Direct shortcuts
  ask)
    shift
    if [ "$CURRENT_DEVICE" = "phone" ]; then
      ~/bin/ask "$@"
    else
      echo "Copilot 'ask' is available on phone."
    fi
    ;;
  clip-ask)
    ~/bin/clip-ask
    ;;
  clip-run)
    ~/bin/clip-run
    ;;
  guard)
    ~/bin/smart-guard.sh && echo "🛡️ Battery & Thermals: SAFE"
    ;;
  top|desk-top)
    if [ "$CURRENT_DEVICE" = "desktop" ]; then
      /home/jpi/.local/bin/desk-status 2>/dev/null || htop
    else
      ssh -o ConnectTimeout=3 -t jpi@$DESKTOP_IP "/home/jpi/.local/bin/desk-status"
    fi
    ;;
  gpu|desk-gpu)
    if [ "$CURRENT_DEVICE" = "desktop" ]; then
      nvidia-smi --query-gpu=name,utilization.gpu,memory.used,memory.total,temperature.gpu --format=csv,noheader
    else
      ssh -o ConnectTimeout=3 jpi@$DESKTOP_IP "nvidia-smi --query-gpu=name,utilization.gpu,memory.used,memory.total,temperature.gpu --format=csv,noheader"
    fi
    ;;
  lock|desk-lock)
    if [ "$CURRENT_DEVICE" = "desktop" ]; then
      loginctl lock-session 2>/dev/null || hyprctl dispatch exit 2>/dev/null || true
    else
      ssh -o ConnectTimeout=3 jpi@$DESKTOP_IP "loginctl lock-session 2>/dev/null || true"
    fi
    ;;
  *)
    echo "Unknown command: $1. Running default menu for $CURRENT_DEVICE..."
    sleep 0.5
    case "$CURRENT_DEVICE" in
      phone) exec "$SCRIPT_DIR/omni-phone" ;;
      laptop) exec "$SCRIPT_DIR/omni-laptop" ;;
      desktop) exec "$SCRIPT_DIR/omni-desktop" ;;
    esac
    ;;
esac
