#!/usr/bin/env bash
# ==============================================================================
#  OMNI PHONE — Dedicated Mobile Workstation Interface
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/omni-core.sh"

toggle_wakelock() {
  if [ -f "$PREFIX/var/run/wake-lock" ]; then
    termux-wake-unlock 2>/dev/null
    rm -f "$PREFIX/var/run/wake-lock"
    echo -e "${C_YELLOW}[!] Wake lock released. Background notification cleared.${C_RESET}"
  else
    termux-wake-lock 2>/dev/null
    mkdir -p "$PREFIX/var/run" 2>/dev/null
    touch "$PREFIX/var/run/wake-lock"
    echo -e "${C_GREEN}[✓] Wake lock acquired. Background services active.${C_RESET}"
  fi
}

phone_media_control() {
  echo -e "\n${C_CYAN}${C_BOLD}🎵 Desktop Media Control:${C_RESET}"
  echo -e "  [space] Desktop Play/Pause   [m] Desktop Mute Toggle"
  echo -e "  [+]     Desktop Vol +5%      [-] Desktop Vol -5%"
  echo -e "  ${C_DIM}[q / Enter] Cancel back to menu${C_RESET}"
  read -rsn1 -p "Select media action: " mact
  echo ""
  case "$mact" in
    ""|q|Q) return 0 ;;
    " ") ssh -o ConnectTimeout=2 "${DESKTOP_USER}@${DESKTOP_IP}" "playerctl play-pause 2>/dev/null || wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" ;;
    m|M) ssh -o ConnectTimeout=2 "${DESKTOP_USER}@${DESKTOP_IP}" "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle 2>/dev/null" ;;
    +)   ssh -o ConnectTimeout=2 "${DESKTOP_USER}@${DESKTOP_IP}" "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ 2>/dev/null" ;;
    -)   ssh -o ConnectTimeout=2 "${DESKTOP_USER}@${DESKTOP_IP}" "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- 2>/dev/null" ;;
  esac
}

phone_wake_desktop() {
  echo -e "${C_CYAN}[*] Sending Wake-on-LAN magic packet to Desktop...${C_RESET}"
  if [ -n "$DESKTOP_MAC" ] && omni_wake_mac "$DESKTOP_MAC"; then
    echo -e "${C_GREEN}[✓] WoL packet transmitted to $DESKTOP_MAC.${C_RESET}"
  else
    echo -e "${C_YELLOW}[!] Failed to transmit WoL or DESKTOP_MAC is empty.${C_RESET}"
  fi
}

phone_clip_to_obsidian() {
  local clip
  clip=$(omni_get_clipboard)
  if [ -z "$clip" ]; then
    echo -e "${C_YELLOW}[!] Clipboard is empty.${C_RESET}"
    return 1
  fi

  echo -e "${C_CYAN}${C_BOLD}[📓 Ingest Clipboard to Desktop Obsidian]:${C_RESET}"
  echo "$clip" | head -n 6
  [ $(echo "$clip" | wc -l) -gt 6 ] && echo -e "${C_DIM}... (truncated)${C_RESET}"
  echo ""
  echo -e "${C_DIM}(Press 'q' or 'c' to cancel back to menu, or Enter for default title)${C_RESET}"
  read -r -p "Note title: " ntitle

  if [[ "$ntitle" =~ ^[qQcCeE]$ ]]; then
    echo -e "${C_DIM}Note capture cancelled. Returning to menu...${C_RESET}"
    return 0
  fi

  [ -z "$ntitle" ] && ntitle="Phone-Clip-$(date +%Y%m%d-%H%M)"
  local fname="${ntitle// /_}.md"
  
  echo -e "${C_CYAN}[*] Appending note to Desktop Obsidian Vault...${C_RESET}"
  ssh -o ConnectTimeout=3 "${DESKTOP_USER}@${DESKTOP_IP}" "mkdir -p \"\$HOME/Documents/Obsidian Vault/Agent-Continuous-Knowledge\" && cat << 'EOFNOTE' >> \"\$HOME/Documents/Obsidian Vault/Agent-Continuous-Knowledge/$fname\"
# $ntitle

- **Date:** \$(date '+%Y-%m-%d %H:%M:%S')
- **Source:** Phone Omni CLI
- **Tags:** #phone-clip #omni

## Content
\`\`\`text
$clip
\`\`\`

---
EOFNOTE
" && echo -e "${C_GREEN}[✓] Saved to Desktop Obsidian Vault!${C_RESET}" || echo -e "${C_RED}[!] Could not reach Desktop.${C_RESET}"
}

while true; do
  b_stat=$(termux-battery-status 2>/dev/null | jq -r '"\(.percentage)% (\(if .plugged == "PLUGGED_AC" then "⚡" else "🔋" end))"' 2>/dev/null || echo "?")
  d_stat="${C_RED}down${C_RESET}"; omni_is_online "$DESKTOP_IP" && d_stat="${C_GREEN}$(omni_ts_ping "$DESKTOP_IP")${C_RESET}"
  l_stat="${C_RED}down${C_RESET}"; omni_is_online "$LAPTOP_IP" && l_stat="${C_GREEN}$(omni_ts_ping "$LAPTOP_IP")${C_RESET}"
  
  omni_render_header "Mobile Terminal" "│ 🔋 $b_stat │ Desktop: $d_stat │ Laptop: $l_stat"

  echo -e "${C_CYAN}${C_BOLD}  🧠 SMART COPILOT & CLIPBOARD (Phone-Native)${C_RESET}"
  echo -e "  ${C_CYAN}[1]${C_RESET} 🤖 Ask Copilot           (Desktop GPU / Local fallback)"
  echo -e "  ${C_CYAN}[v]${C_RESET} 🎙️  Voice Assistant       (Speak prompt -> AI audio reply)"
  echo -e "  ${C_CYAN}[2]${C_RESET} 📋 Send Clipboard to AI   (clip-ask)"
  echo -e "  ${C_CYAN}[3]${C_RESET} ⚡ Run Clipboard Command  (clip-run)"
  echo -e "  ${C_CYAN}[o]${C_RESET} 📓 Ingest Clip to Note    (Optional save to desktop vault)"
  echo -e "  ${C_CYAN}[c]${C_RESET} 📋 Cross-Device Clipboard (Push/Pull to Desktop/Laptop)"
  echo -e "  ${C_CYAN}[4]${C_RESET} 🛡️  Check Sentinel Guard   (guard)"
  echo -e "  ${C_CYAN}[w]${C_RESET} 🔔 Toggle Wake Lock      (Clear/keep notification)"
  echo ""
  echo -e "${C_GREEN}${C_BOLD}  🤖 REMOTE AI WORKSPACES (Desktop GPU)${C_RESET}"
  echo -e "  ${C_CYAN}[5]${C_RESET} 🚀 Antigravity / Agy      (Desktop 'ai' session)"
  echo -e "  ${C_CYAN}[6]${C_RESET} 🟣 Claude Code            (Desktop 'claude' session)"
  echo -e "  ${C_CYAN}[7]${C_RESET} 💻 Aider Pair Programmer  (Desktop 'aider' session)"
  echo -e "  ${C_CYAN}[8]${C_RESET} ⚡ Jev Intelligent Router (Interactive chat)"
  echo ""
  echo -e "${C_YELLOW}${C_BOLD}  🌐 CONNECTIVITY, MEDIA & SHELLS (Multi-Device)${C_RESET}"
  echo -e "  ${C_CYAN}[s]${C_RESET} 🐚 Local Phone Shell      (${PHONE_IP:-127.0.0.1}:${PHONE_PORT})"
  echo -e "  ${C_CYAN}[d]${C_RESET} 🖥️  Desktop Terminal (SSH) (${DESKTOP_IP:-unknown})"
  echo -e "  ${C_CYAN}[l]${C_RESET} 💻 Laptop Terminal (SSH)  (${LAPTOP_IP:-unknown})"
  echo -e "  ${C_CYAN}[m]${C_RESET} 🎵 Remote Desktop Media   (Play/pause, vol, mute)"
  echo -e "  ${C_CYAN}[t]${C_RESET} 📊 Desktop System Top     (CPU, RAM, GPU)"
  echo -e "  ${C_CYAN}[u]${C_RESET} 🎮 Desktop VRAM & GPU Temp"
  echo -e "  ${C_CYAN}[k]${C_RESET} 🔒 Lock Desktop Screen"
  echo -e "  ${C_CYAN}[x]${C_RESET} ⚡ Wake Desktop (Wake-on-LAN)"
  echo ""
  echo -e "${C_BLUE}${C_BOLD}  📁 3-WAY FILE TRANSFER & SYNC${C_RESET}"
  echo -e "  ${C_CYAN}[f]${C_RESET} 📁 Send File to Desktop or Laptop (omni send)"
  echo -e "  ${C_CYAN}[y]${C_RESET} 🔄 Sync Updates from Desktop (sync-down)"
  echo -e "  ${C_CYAN}[z]${C_RESET} 🔍 Fuzzy Action Search    (omni -f)"
  echo -e "  ${C_DIM}[Enter / q]${C_RESET} 🚪 Exit Menu back to Shell"
  echo ""
  read -rsn1 -p "Select option [Enter/q to exit]: " choice
  echo ""

  case "$choice" in
    ""|q|Q) exit 0 ;;
    s|S)
      echo -e "${C_CYAN}[*] Dropping into interactive local shell...${C_RESET}"
      "${SHELL:-bash}" -l
      ;;
    d|D) ssh -o ConnectTimeout=3 -t "${DESKTOP_USER}@${DESKTOP_IP}" ;;
    1) read -r -p "Prompt ('q' to cancel): " p; [ -n "$p" ] && [[ ! "$p" =~ ^[qQ]$ ]] && ~/bin/ask "$p" ;;
    v|V) "$SCRIPT_DIR/omni-voice" ;;
    2) ~/bin/clip-ask ;;
    3) ~/bin/clip-run ;;
    o|O) phone_clip_to_obsidian ;;
    c|C) "$SCRIPT_DIR/omni-clip" ;;
    4) ~/bin/smart-guard.sh && echo -e "${C_GREEN}🛡️ Battery & Thermals: SAFE${C_RESET}" ;;
    w|W) toggle_wakelock ;;
    5) ssh -o ConnectTimeout=3 -t "${DESKTOP_USER}@${DESKTOP_IP}" "/home/${DESKTOP_USER}/ap" ;;
    6) ssh -o ConnectTimeout=3 -t "${DESKTOP_USER}@${DESKTOP_IP}" "/home/${DESKTOP_USER}/.local/bin/claude-phone" ;;
    7) ssh -o ConnectTimeout=3 -t "${DESKTOP_USER}@${DESKTOP_IP}" "/home/${DESKTOP_USER}/.local/bin/aider-phone" ;;
    8) ssh -o ConnectTimeout=3 -t "${DESKTOP_USER}@${DESKTOP_IP}" "/home/${DESKTOP_USER}/.local/bin/jev-chat" ;;
    m|M) phone_media_control ;;
    t|T) ssh -o ConnectTimeout=3 -t "${DESKTOP_USER}@${DESKTOP_IP}" "/home/${DESKTOP_USER}/.local/bin/desk-status" ;;
    u|U) ssh -o ConnectTimeout=3 "${DESKTOP_USER}@${DESKTOP_IP}" "nvidia-smi --query-gpu=name,utilization.gpu,memory.used,memory.total,temperature.gpu --format=csv,noheader" ;;
    k|K) ssh -o ConnectTimeout=3 "${DESKTOP_USER}@${DESKTOP_IP}" "loginctl lock-session 2>/dev/null || true" && echo -e "${C_GREEN}[✓] Desktop locked.${C_RESET}" ;;
    x|X) phone_wake_desktop ;;
    l|L) ssh -o ConnectTimeout=3 -t "${LAPTOP_USER}@${LAPTOP_IP}" ;;
    f|F)
      read -e -p "Enter path to file ('q' to cancel): " fpath
      if [ -n "$fpath" ] && [[ ! "$fpath" =~ ^[qQ]$ ]]; then
        "$SCRIPT_DIR/omni-send" "$fpath"
      fi
      ;;
    y|Y) sync-down ;;
    z|Z) "$SCRIPT_DIR/omni-fzf" ;;
    *)
      if ! omni_exec_custom "$choice"; then
        echo "Invalid option: $choice"
        sleep 0.8
      fi
      ;;
  esac
  echo ""
  read -rp "Press Enter to continue (or 'q' to exit to shell)... " cont
  [[ "$cont" =~ ^[qQ]$ ]] && exit 0
done
