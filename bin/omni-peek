#!/usr/bin/env bash
# ==============================================================================
#  OMNI PEEK — Live Cross-Device Screen Capture & Remote Inspection
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/omni-core.sh"

CURRENT_DEV=$(omni_detect_device)

echo -e "${C_CYAN}${C_BOLD}"
cat << "BANNER"
  ___  __  __ _   _ ___   ____  _____ _____ _  __
 / _ \|  \/  | \ | |_ _| |  _ \| ____| ____| |/ /
| | | | |\/| |  \| || |  | |_) |  _| |  _| | ' / 
| |_| | |  | | |\  || |  |  __/| |___| |___| . \ 
 \___/|_|  |_|_| \_|___| |_|   |_____|_____|_|\_\
BANNER
echo -e "${C_RESET}${C_DIM}─────────────────────────────────────────────────────────────────${C_RESET}"
echo -e " ${C_BOLD}Cross-Device Screen Capture & Live Remote Peek${C_RESET}"
echo -e "${C_DIM}─────────────────────────────────────────────────────────────────${C_RESET}\n"

echo -e "Select peek action:"
echo -e "  ${C_CYAN}[1]${C_RESET} 🖥️  Peek Desktop Screen (Capture Desktop & view here)"
echo -e "  ${C_CYAN}[2]${C_RESET} 💻 Peek Laptop Screen  (Capture Laptop & view here)"
echo -e "  ${C_CYAN}[3]${C_RESET} 📱 Capture S24 Photo   (Trigger Phone Camera -> Download)"
echo -e "  ${C_CYAN}[b]${C_RESET} 🔙 Back to OMNI Menu"
echo -e "  ${C_CYAN}[q]${C_RESET} 🚪 Quit to Shell"
echo ""

read -rsn1 -p "Select option: " p_opt
echo ""

case "$p_opt" in
  b|B) exec omni ;;
  ""|q|Q) exit 0 ;;
  1)
    echo -e "${C_CYAN}[*] Requesting screenshot from Desktop ($DESKTOP_IP)...${C_RESET}"
    if ! omni_is_online "$DESKTOP_IP"; then
      echo -e "${C_RED}[!] Desktop is offline.${C_RESET}"
    else
      local_peek="/tmp/desktop_peek_$(date +%s).png"
      # Capture on desktop via grim
      ssh -o ConnectTimeout=3 "${DESKTOP_USER}@${DESKTOP_IP}" "DISPLAY=:0 WAYLAND_DISPLAY=\${WAYLAND_DISPLAY:-wayland-1} grim /tmp/omni_peek.png 2>/dev/null" && \
        scp "${DESKTOP_USER}@${DESKTOP_IP}:/tmp/omni_peek.png" "$local_peek" 2>/dev/null
      
      if [ -f "$local_peek" ]; then
        echo -e "${C_GREEN}[✓] Screenshot captured: $local_peek${C_RESET}"
        if [ "$CURRENT_DEV" = "phone" ]; then
          termux-open "$local_peek" 2>/dev/null || echo -e "Saved to $local_peek"
        elif command -v xdg-open >/dev/null 2>&1; then
          xdg-open "$local_peek" 2>/dev/null || true
        fi
      else
        echo -e "${C_RED}[!] Failed to capture Desktop screenshot (ensure grim is installed).${C_RESET}"
      fi
    fi
    ;;
  2)
    echo -e "${C_CYAN}[*] Requesting screenshot from Laptop ($LAPTOP_IP)...${C_RESET}"
    if ! omni_is_online "$LAPTOP_IP"; then
      echo -e "${C_RED}[!] Laptop is offline.${C_RESET}"
    else
      local_peek="/tmp/laptop_peek_$(date +%s).png"
      ssh -o ConnectTimeout=3 "${LAPTOP_USER}@${LAPTOP_IP}" "DISPLAY=:0 WAYLAND_DISPLAY=\${WAYLAND_DISPLAY:-wayland-1} grim /tmp/omni_peek.png 2>/dev/null" && \
        scp "${LAPTOP_USER}@${LAPTOP_IP}:/tmp/omni_peek.png" "$local_peek" 2>/dev/null
      
      if [ -f "$local_peek" ]; then
        echo -e "${C_GREEN}[✓] Screenshot captured: $local_peek${C_RESET}"
        if [ "$CURRENT_DEV" = "phone" ]; then
          termux-open "$local_peek" 2>/dev/null || echo -e "Saved to $local_peek"
        elif command -v xdg-open >/dev/null 2>&1; then
          xdg-open "$local_peek" 2>/dev/null || true
        fi
      else
        echo -e "${C_RED}[!] Failed to capture Laptop screenshot.${C_RESET}"
      fi
    fi
    ;;
  3)
    echo -e "${C_CYAN}[*] Triggering S24 camera photo...${C_RESET}"
    if ! omni_is_online "$PHONE_IP"; then
      echo -e "${C_RED}[!] Phone is offline.${C_RESET}"
    else
      local_photo="$HOME/Downloads/s24_snap_$(date +%s).jpg"
      ssh -p "$PHONE_PORT" -o ConnectTimeout=3 "${PHONE_USER}@${PHONE_IP}" "termux-camera-photo -c 0 /sdcard/Download/omni_snap.jpg" 2>/dev/null && \
        scp -P "$PHONE_PORT" "${PHONE_USER}@${PHONE_IP}:/sdcard/Download/omni_snap.jpg" "$local_photo" 2>/dev/null
      
      if [ -f "$local_photo" ]; then
        echo -e "${C_GREEN}[✓] Photo saved: $local_photo${C_RESET}"
        command -v xdg-open >/dev/null 2>&1 && xdg-open "$local_photo" 2>/dev/null || true
      else
        echo -e "${C_RED}[!] Photo capture failed.${C_RESET}"
      fi
    fi
    ;;
esac

echo ""
echo -e "Navigation: [b] Back to OMNI Menu  |  [Enter / q] Exit to Shell"
read -rsn1 -p "Select action: " nav_act
echo ""

case "$nav_act" in
  b|B) exec omni ;;
  *) exit 0 ;;
esac
