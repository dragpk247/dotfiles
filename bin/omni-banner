#!/usr/bin/env bash
# Fast non-blocking OMNI terminal banner for interactive shells

# Avoid printing in subshells, scripts, or non-interactive sessions
[[ $- != *i* ]] && return 2>/dev/null || true

C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_BOLD="\033[1m"
C_DIM="\033[2m"
C_RESET="\033[0m"

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omni"
mkdir -p "$CACHE_DIR" 2>/dev/null

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/omni/config.env"
if [ -f "$CONFIG_FILE" ]; then
  # shellcheck source=/dev/null
  source "$CONFIG_FILE"
fi

PHONE_IP="${PHONE_IP:-127.0.0.1}"
LAPTOP_IP="${LAPTOP_IP:-127.0.0.1}"
DESKTOP_IP="${DESKTOP_IP:-127.0.0.1}"

# Detect if we are on laptop or desktop to show the OTHER peer status
LOCAL_HOST=$(hostname)
PEER_NAME="Desktop"
PEER_IP="$DESKTOP_IP"
if [[ "$LOCAL_HOST" =~ "desktop" ]]; then
  PEER_NAME="Laptop"
  PEER_IP="$LAPTOP_IP"
fi

# Read cache if fresh (< 30s)
CACHE_FILE="$CACHE_DIR/status_cache"
NOW=$(date +%s)
p_stat="${C_GREEN}Online${C_RESET}"
peer_stat="${C_GREEN}Online${C_RESET}"

if [ -f "$CACHE_FILE" ]; then
  # shellcheck source=/dev/null
  source "$CACHE_FILE"
fi

if [ -z "${STATUS_TIMESTAMP:-}" ] || [ $((NOW - STATUS_TIMESTAMP)) -ge 30 ]; then
  (
    p_ok=0; peer_ok=0
    ping -c 1 -W 1 "$PHONE_IP" >/dev/null 2>&1 && p_ok=1
    ping -c 1 -W 1 "$PEER_IP" >/dev/null 2>&1 && peer_ok=1
    cat << STAT > "$CACHE_FILE.tmp"
STATUS_TIMESTAMP=$NOW
CACHE_P_OK=$p_ok
CACHE_PEER_OK=$peer_ok
STAT
    mv -f "$CACHE_FILE.tmp" "$CACHE_FILE"
  ) >/dev/null 2>&1 &
fi

[ "${CACHE_P_OK:-1}" = "1" ] && p_stat="${C_GREEN}Online${C_RESET}" || p_stat="${C_RED}Offline${C_RESET}"
[ "${CACHE_PEER_OK:-1}" = "1" ] && peer_stat="${C_GREEN}Online${C_RESET}" || peer_stat="${C_RED}Offline${C_RESET}"

# Fast local metrics (< 5ms)
HOST=$(hostname)
UPTIME_SHORT=$(uptime -p 2>/dev/null | sed -e 's/up //' -e 's/ hours\?,/h/' -e 's/ minutes\?/m/' || echo "active")
MEM_PCT=$(free | awk '/Mem:/ {printf "%.0f%%", $3/$2*100}')
CPU_PCT=$(top -bn1 | grep "Cpu(s)" | awk '{printf "%.0f%%", $2 + $4}')

# GPU Info
GPU_DATA=""
if command -v nvidia-smi >/dev/null 2>&1; then
  GPU_RAW=$(nvidia-smi --query-gpu=utilization.gpu,temperature.gpu --format=csv,noheader,nounits 2>&1)
  if [ $? -eq 0 ] && [ -n "$GPU_RAW" ] && [[ ! "$GPU_RAW" =~ "failed" ]] && [[ ! "$GPU_RAW" =~ "NVIDIA-SMI" ]]; then
    IFS=',' read -r g_util g_temp <<< "$GPU_RAW"
    GPU_DATA=" │ ${C_DIM}GPU:${C_RESET} ${g_util// /}% (${g_temp// /}°C)"
  fi
fi

# Detect terminal width
cols=$(tput cols 2>/dev/null || echo "${COLUMNS:-80}")
[ -z "$cols" ] || [ "$cols" -le 0 ] && cols=80
hr_width=$(( cols < 75 ? cols : 75 ))
hr_line=$(printf "${C_DIM}%.0s─${C_RESET}" $(seq 1 "$hr_width"))

if [ "$cols" -ge 65 ]; then
  # Full wide ASCII banner
  echo -e "${C_CYAN}"
  cat << "BANNER"
  ___  __  __ _   _ ___   ____ _     ___ 
 / _ \|  \/  | \ | |_ _| / ___| |   |_ _|
| | | | |\/| |  \| || | | |   | |    | | 
| |_| | |  | | |\  || | | |___| |___ | | 
 \___/|_|  |_|_| \_|___| \____|_____|___|
BANNER
  echo -e "$hr_line"
  echo -e " ${C_BOLD}OMNI System Control${C_RESET} ${C_YELLOW}v1.3.0${C_RESET} │ ${C_BOLD}Host:${C_RESET} ${C_GREEN}${HOST}${C_RESET} (${UPTIME_SHORT}) │ Phone: ${p_stat} │ ${PEER_NAME}: ${peer_stat}"
  echo -e " ${C_DIM}Telemetry:${C_RESET} CPU: ${CPU_PCT} │ RAM: ${MEM_PCT}${GPU_DATA} │ ${C_DIM}Dashboard:${C_RESET} type ${C_BOLD}'m'${C_RESET} or ${C_BOLD}'menu'${C_RESET}"
  echo -e "$hr_line"
elif [ "$cols" -ge 46 ]; then
  # Medium width banner (e.g., split-pane or tablet)
  echo -e "$hr_line"
  echo -e " ${C_CYAN}${C_BOLD}⚡ OMNI Control${C_RESET} ${C_YELLOW}v1.3.0${C_RESET} │ ${C_GREEN}${HOST}${C_RESET} (${UPTIME_SHORT})"
  echo -e " Phone: ${p_stat} │ ${PEER_NAME}: ${peer_stat} │ CPU: ${CPU_PCT} │ RAM: ${MEM_PCT}"
  echo -e " ${C_DIM}Dashboard:${C_RESET} type ${C_BOLD}'m'${C_RESET} or ${C_BOLD}'omni'${C_RESET}"
  echo -e "$hr_line"
else
  # Mobile / narrow view (e.g. Phone Termux)
  echo -e "${C_CYAN}${C_BOLD}⚡ OMNI v1.3.0${C_RESET} │ ${C_GREEN}${HOST}${C_RESET} (${UPTIME_SHORT})"
  echo -e " ${p_stat} Phone │ ${peer_stat} ${PEER_NAME} │ ${CPU_PCT} CPU"
  echo -e "$hr_line"
fi
echo ""
