#!/usr/bin/env bash
# Fast non-blocking OMNI terminal banner for interactive shells

# Avoid printing in subshells, scripts, or non-interactive sessions
[[ $- != *i* ]] && return 2>/dev/null || true

C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_BOLD="\033[1m"
C_DIM="\033[2m"
C_RESET="\033[0m"

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omni"
mkdir -p "$CACHE_DIR" 2>/dev/null

PHONE_IP="100.118.50.88"
LAPTOP_IP="100.72.213.23"

# Read cache if fresh (< 30s)
CACHE_FILE="$CACHE_DIR/status_cache"
NOW=$(date +%s)
p_stat="${C_GREEN}Online${C_RESET}"
l_stat="${C_GREEN}Online${C_RESET}"

if [ -f "$CACHE_FILE" ]; then
  # shellcheck source=/dev/null
  source "$CACHE_FILE"
fi

if [ -z "${STATUS_TIMESTAMP:-}" ] || [ $((NOW - STATUS_TIMESTAMP)) -ge 30 ]; then
  (
    p_ok=0; l_ok=0
    ping -c 1 -W 1 "$PHONE_IP" >/dev/null 2>&1 && p_ok=1
    ping -c 1 -W 1 "$LAPTOP_IP" >/dev/null 2>&1 && l_ok=1
    cat << STAT > "$CACHE_FILE.tmp"
STATUS_TIMESTAMP=$NOW
CACHE_P_OK=$p_ok
CACHE_L_OK=$l_ok
STAT
    mv -f "$CACHE_FILE.tmp" "$CACHE_FILE"
  ) >/dev/null 2>&1 &
fi

[ "${CACHE_P_OK:-1}" = "1" ] && p_stat="${C_GREEN}Online${C_RESET}" || p_stat="${C_RED}Offline${C_RESET}"
[ "${CACHE_L_OK:-1}" = "1" ] && l_stat="${C_GREEN}Online${C_RESET}" || l_stat="${C_RED}Offline${C_RESET}"

# Fast local metrics (< 5ms)
HOST=$(hostname)
UPTIME_SHORT=$(uptime -p 2>/dev/null | sed -e 's/up //' -e 's/ hours\?,/h/' -e 's/ minutes\?/m/' || echo "active")
MEM_PCT=$(free | awk '/Mem:/ {printf "%.0f%%", $3/$2*100}')
CPU_PCT=$(top -bn1 | grep "Cpu(s)" | awk '{printf "%.0f%%", $2 + $4}')

# GPU Info
GPU_DATA=""
if command -v nvidia-smi >/dev/null 2>&1; then
  GPU_RAW=$(nvidia-smi --query-gpu=utilization.gpu,temperature.gpu --format=csv,noheader,nounits 2>/dev/null || echo "")
  if [ -n "$GPU_RAW" ]; then
    IFS=',' read -r g_util g_temp <<< "$GPU_RAW"
    GPU_DATA=" │ ${C_DIM}GPU:${C_RESET} ${g_util// /}% (${g_temp// /}°C)"
  fi
fi

# Print Full OMNI CLI Banner
echo -e "${C_CYAN}"
cat << "BANNER"
  ___  __  __ _   _ ___   ____ _     ___ 
 / _ \|  \/  | \ | |_ _| / ___| |   |_ _|
| | | | |\/| |  \| || | | |   | |    | | 
| |_| | |  | | |\  || | | |___| |___ | | 
 \___/|_|  |_|_| \_|___| \____|_____|___|
BANNER
echo -e "${C_RESET}${C_DIM}─────────────────────────────────────────────────────────────────${C_RESET}"
echo -e " ${C_BOLD}OMNI System Control${C_RESET} ${C_YELLOW}v1.2.0${C_RESET} │ ${C_BOLD}Host:${C_RESET} ${C_GREEN}${HOST}${C_RESET} (${UPTIME_SHORT}) │ Phone: ${p_stat} │ Laptop: ${l_stat}"
echo -e " ${C_DIM}Telemetry:${C_RESET} CPU: ${CPU_PCT} │ RAM: ${MEM_PCT}${GPU_DATA} │ ${C_DIM}Dashboard:${C_RESET} type ${C_BOLD}'m'${C_RESET} or ${C_BOLD}'menu'${C_RESET}"
echo -e "${C_DIM}─────────────────────────────────────────────────────────────────${C_RESET}"
echo ""
