#!/bin/bash
# Toggle a floating dropdown terminal in Hyprland
if ! hyprctl clients -j | jq -e '.[] | select(.class == "dropdown-terminal")' >/dev/null 2>&1; then
    setsid kitty --class=dropdown-terminal >/dev/null 2>&1 &
    sleep 0.2
fi
hyprctl eval 'hl.dispatch(hl.dsp.workspace.toggle_special("dropdown"))' >/dev/null 2>&1
