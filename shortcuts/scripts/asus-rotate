#!/bin/bash
# asus-rotate: Manual or automated screen rotation for ASUS ROG Flow 13

TARGET="${1:-normal}"

case "$TARGET" in
    0|normal|laptop)
        TRANS=0
        ;;
    1|right|portrait-right|90)
        TRANS=1
        ;;
    2|inverted|upside-down|180|tent)
        TRANS=2
        ;;
    3|left|portrait-left|270)
        TRANS=3
        ;;
    *)
        echo "Usage: $0 [0|1|2|3|normal|right|inverted|left]"
        exit 1
        ;;
esac

# Get current refresh rate and AC state
AC_STATUS=$(cat /sys/class/power_supply/AC0/online 2>/dev/null || echo 1)
if [ "$AC_STATUS" -eq 1 ]; then
    RATE="120"
else
    RATE="60"
fi

hyprctl eval "hl.monitor({ output = 'eDP-1', mode = '1920x1200@$RATE', position = '0x0', scale = 1.25, transform = $TRANS })" >/dev/null 2>&1
omarchy-notification-send -g 🔄 "Screen Rotated" "Orientation transform set to $TARGET"
