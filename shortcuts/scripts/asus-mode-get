#!/bin/bash
# Get current mode for ASUS ROG Flow 13
STATE_FILE="$HOME/.local/state/omarchy/toggles/tablet-mode"
TRANS=$(hyprctl monitors -j 2>/dev/null | jq -r '.[0].transform // 0')

if [ -f "$STATE_FILE" ]; then
    if [ "$TRANS" = "2" ]; then
        echo "tent"
    elif [ "$TRANS" = "1" ] || [ "$TRANS" = "3" ]; then
        echo "portrait"
    else
        echo "tablet"
    fi
else
    if [ "$TRANS" = "0" ]; then
        echo "laptop"
    elif [ "$TRANS" = "2" ]; then
        echo "tent"
    elif [ "$TRANS" = "1" ] || [ "$TRANS" = "3" ]; then
        echo "portrait"
    else
        echo "laptop"
    fi
fi
