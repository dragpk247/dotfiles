#!/bin/bash
# Toggle battery charge limit between Desk Mode (80%) and Travel Mode (100%)
# for ASUS ROG Flow 13 to extend battery cycle lifespan.

ACTION="${1:-toggle}"

get_limit() {
    asusctl battery info 2>/dev/null | grep -oE '[0-9]+' | head -n1
}

set_limit() {
    local target="$1"
    asusctl battery limit "$target" >/dev/null 2>&1
    if [ "$target" -le 80 ]; then
        omarchy-notification-send -g 🛡️ "Battery: Desk Mode (80%)" "Charge limited to 80% to preserve battery lifespan."
    else
        omarchy-notification-send -g 🔋 "Battery: Travel Mode (100%)" "Full charge enabled for maximum portability."
    fi
}

case "$ACTION" in
    desk|80)
        set_limit 80
        ;;
    travel|100)
        set_limit 100
        ;;
    toggle)
        CURRENT=$(get_limit)
        if [ "$CURRENT" -eq 80 ]; then
            set_limit 100
        else
            set_limit 80
        fi
        ;;
    status)
        echo "Current charge limit: $(get_limit)%"
        ;;
    *)
        echo "Usage: $0 [toggle|desk|travel|status]"
        exit 1
        ;;
esac
