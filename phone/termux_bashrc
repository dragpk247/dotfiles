# ==========================================
# Termux Configuration - Samsung S24
# ==========================================

# ── Colors & Styles ──
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_DIM="\033[2m"
C_CYAN="\033[36m"
C_GREEN="\033[32m"
C_YELLOW="\033[33m"
C_RED="\033[31m"
C_PURPLE="\033[35m"
C_BLUE="\033[34m"

# ==========================================
# 🔒 S24 SECURITY GATE (Biometric + PIN Fallback + 15-Min Timer)
# ==========================================
# Grants a 15-minute (900s) grace period so you don't have to enter PIN constantly
if [[ $- == *i* ]]; then
    _s24_authenticate() {
        local auth_success=0
        local pin_hash_file="$HOME/.termux_pin_hash"
        local auth_token_file="${TMPDIR:-$HOME/.cache}/.s24_auth_token"
        local auth_timeout=900  # 15 minutes grace period

        # Check if active session token exists and is still valid
        if [ -f "$auth_token_file" ]; then
            local token_time
            token_time=$(cat "$auth_token_file" 2>/dev/null || echo 0)
            local current_time
            current_time=$(date +%s)
            local elapsed=$((current_time - token_time))

            if [ $elapsed -ge 0 ] && [ $elapsed -lt $auth_timeout ]; then
                # Refresh token and bypass PIN
                echo "$current_time" > "$auth_token_file" 2>/dev/null
                return 0
            fi
        fi

        # 1. Try Samsung Biometric Fingerprint (if termux-api is installed)
        if command -v termux-fingerprint >/dev/null 2>&1; then
            echo -e "${C_CYAN}🔐 S24 Security: Touch fingerprint sensor...${C_RESET}"
            local fp_res
            fp_res=$(termux-fingerprint -t "Verify S24 Terminal" -d "Touch sensor or press cancel for PIN" 2>&1)
            if echo "$fp_res" | grep -q '"auth_result": "AUTH_RESULT_SUCCESS"'; then
                auth_success=1
            fi
        fi

        # 2. PIN Fallback (if fingerprint cancelled, failed, or termux-api not present)
        if [ $auth_success -ne 1 ]; then
            if [ ! -f "$pin_hash_file" ]; then
                echo -e "${C_YELLOW}⚠ No PIN configured. Let's create a 4-8 digit Termux security PIN:${C_RESET}"
                read -s -p "Enter new PIN: " new_pin
                echo ""
                read -s -p "Confirm PIN: " conf_pin
                echo ""
                if [ -n "$new_pin" ] && [ "$new_pin" = "$conf_pin" ]; then
                    echo -n "$new_pin" | sha256sum | awk '{print $1}' > "$pin_hash_file"
                    chmod 600 "$pin_hash_file"
                    echo -e "${C_GREEN}✓ PIN successfully set!${C_RESET}"
                    auth_success=1
                else
                    echo -e "${C_RED}✖ PINs did not match or empty. Exiting.${C_RESET}"
                    exit 1
                fi
            else
                local attempts=3
                while [ $attempts -gt 0 ]; do
                    read -s -p "🔑 Enter Security PIN ($attempts attempts left): " entered_pin
                    echo ""
                    local entered_hash
                    entered_hash=$(echo -n "$entered_pin" | sha256sum | awk '{print $1}')
                    local expected_hash
                    expected_hash=$(cat "$pin_hash_file" 2>/dev/null)

                    if [ "$entered_hash" = "$expected_hash" ]; then
                        auth_success=1
                        break
                    else
                        attempts=$((attempts - 1))
                        [ $attempts -gt 0 ] && echo -e "${C_RED}✖ Incorrect PIN.${C_RESET}"
                    fi
                done
            fi
        fi

        if [ $auth_success -ne 1 ]; then
            echo -e "\n${C_RED}✖ Authentication failed. Terminal locked.${C_RESET}"
            sleep 1
            exit 1
        fi

        # Save successful authentication timestamp token
        mkdir -p "${TMPDIR:-$HOME/.cache}" 2>/dev/null
        date +%s > "$auth_token_file" 2>/dev/null
        clear
    }

    _s24_authenticate
fi

# ── Shell History Settings ──
export HISTCONTROL=ignoreboth:erasedups
export HISTSIZE=10000
export HISTFILESIZE=20000
shopt -s histappend
shopt -s checkwinsize 2>/dev/null

# ── Mobile Touch-Optimized Prompt ──
_s24_prompt() {
    local exit_code=$?
    local stat_color="\033[32m"
    [ $exit_code -ne 0 ] && stat_color="\033[31m"
    PS1="${stat_color}📱 \033[36m\w ${stat_color}❯\033[0m "
}
PROMPT_COMMAND="_s24_prompt"

# ── Tailscale IP Definitions ──
DESK_IP="100.86.159.86"
LAP_IP="100.72.213.23"
SSH_OPTS="-o ConnectTimeout=3 -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=accept-new"

# ── Fast SSH Connection Wrapper ──
desk_ssh() {
    if ! ping -c 1 -W 1 "$DESK_IP" >/dev/null 2>&1; then
        echo -e "${C_RED}✖ Desktop ($DESK_IP) unreachable via Tailscale.${C_RESET}"
        return 1
    fi
    ssh $SSH_OPTS -t "jpi@$DESK_IP" "$@"
}

