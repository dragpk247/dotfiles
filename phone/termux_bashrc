# ── Clean S24 Banner on Terminal Launch ──
if [[ $- == *i* ]]; then
    # Async / Fast Ping Checks
    TDIR="${TMPDIR:-$HOME/.cache}"
    mkdir -p "$TDIR" 2>/dev/null
    DESK_STAT="${C_YELLOW}Checking...${C_RESET}"
    (ping -c 1 -W 1 "$DESK_IP" >/dev/null 2>&1 && echo "online" > "$TDIR/.s24_desk_stat" || echo "offline" > "$TDIR/.s24_desk_stat") &
    (ping -c 1 -W 1 "$LAP_IP" >/dev/null 2>&1 && echo "online" > "$TDIR/.s24_lap_stat" || echo "offline" > "$TDIR/.s24_lap_stat") &
    wait

    [ "$(cat "$TDIR/.s24_desk_stat" 2>/dev/null)" = "online" ] && DESK_STAT="${C_GREEN}Online${C_RESET}" || DESK_STAT="${C_RED}Offline${C_RESET}"
    [ "$(cat "$TDIR/.s24_lap_stat" 2>/dev/null)" = "online" ] && LAP_STAT="${C_GREEN}Online${C_RESET}" || LAP_STAT="${C_YELLOW}Offline${C_RESET}"
    rm -f "$TDIR/.s24_desk_stat" "$TDIR/.s24_lap_stat" 2>/dev/null

    # Battery
    BAT_INFO=$(termux-battery-status 2>/dev/null | grep -E "percentage|plugged" | tr -d '", ' | paste -sd ' ' -)
    BAT_PERCENT=$(echo "$BAT_INFO" | grep -o 'percentage:[0-9]*' | cut -d: -f2)
    BAT_PLUGGED=$(echo "$BAT_INFO" | grep -o 'plugged:[A-Z_]*' | cut -d: -f2)

    [ -n "$BAT_PERCENT" ] && BAT_STR="${BAT_PERCENT}%" || BAT_STR="N/A"
    [ "$BAT_PLUGGED" != "UNPLUGGED" ] && [ -n "$BAT_PLUGGED" ] && BAT_STR="${BAT_STR} (⚡)"

    echo -e "${C_CYAN}${C_BOLD}⚡ S24 MOBILE WORKSTATION${C_RESET} ${C_DIM}• Security Shield Active${C_RESET}"
    echo -e " ${C_GREEN}● Battery:${C_RESET}  ${BAT_STR}   ${C_GREEN}● Desktop:${C_RESET} ${DESK_STAT}   ${C_GREEN}● Laptop:${C_RESET} ${LAP_STAT}"
    echo -e " ${C_DIM}Type ${C_BOLD}'menu'${C_RESET}${C_DIM} or ${C_BOLD}'?'${C_RESET}${C_DIM} for commands, or jump straight into ${C_BOLD}'agy'${C_RESET}${C_DIM} or ${C_BOLD}'jev'${C_RESET}."
    echo ""
fi

# ── Aliases & Shortcuts ──
alias '?'='menu'
alias help='menu'

# Security Helpers
alias lock-termux="rm -f \${TMPDIR:-\$HOME/.cache}/.s24_auth_token && exit"
alias reset-pin="rm -f ~/.termux_pin_hash \${TMPDIR:-\$HOME/.cache}/.s24_auth_token && echo 'PIN reset. Restart Termux or run reload to set a new PIN.'"

# Jev Gateway
alias jev="desk_ssh /home/jpi/.local/bin/jev-chat"
alias jev-dash="xdg-open 'http://$DESK_IP:8085/dashboard' 2>/dev/null || termux-open-url 'http://$DESK_IP:8085/dashboard'"
alias desk-logs="desk_ssh tail -f /home/jpi/.local/share/obsidian-ai-router/server.log"

# Desktop AI Agents
alias agy="desk_ssh /home/jpi/ap"
alias desk-agy="agy"
alias desk="agy"
alias desk-hermes="desk_ssh hermes chat"
alias desk-claude="desk_ssh /home/jpi/.local/bin/claude-phone"
alias desk-aider="desk_ssh /home/jpi/.local/bin/aider-phone"
alias sync-graphify="desk_ssh /home/jpi/.local/bin/sync-projects-graphify"

# Desktop System Remote Controls
alias desk-top="desk_ssh /home/jpi/.local/bin/desk-status"
alias desk-gpu="ssh $SSH_OPTS jpi@$DESK_IP 'nvidia-smi --query-gpu=name,utilization.gpu,memory.used,memory.total,temperature.gpu --format=csv,noheader'"
alias desk-lock="ssh $SSH_OPTS jpi@$DESK_IP loginctl lock-session && echo '🖥️ Desktop screen locked.'"
alias desk-shell="desk_ssh"

# Laptop Shortcuts
alias lap-agy="ssh $SSH_OPTS -t jpi@$LAP_IP /home/jpi/ap"
alias lap="lap-agy"
alias lap-shell="ssh $SSH_OPTS -t jpi@$LAP_IP"

# Config Sync & Termux Setup
alias sync-down="mkdir -p \${TMPDIR:-\$HOME/.cache} && date +%s > \${TMPDIR:-\$HOME/.cache}/.s24_auth_token && scp \$SSH_OPTS jpi@\$DESK_IP:~/termux_bashrc ~/.bashrc && scp \$SSH_OPTS jpi@\$DESK_IP:~/dotfiles/bin/omni* ~/bin/ 2>/dev/null && chmod +x ~/bin/* && source ~/.bashrc && echo '🚀 Config and Omni CLI updated from desktop!'"
alias sync-up="scp $SSH_OPTS ~/.bashrc jpi@$DESK_IP:~/termux_bashrc && echo 'Config pushed to desktop!'"
alias setup-keys="mkdir -p ~/.termux && scp $SSH_OPTS jpi@$DESK_IP:~/termux_properties ~/.termux/termux.properties && termux-reload-settings && echo 'Touch keys updated!'"

# Mobile Navigation & Maintenance
alias ..="cd .."
alias ...="cd ../.."
alias ~="cd ~"
alias storage="cd ~/storage/shared"
alias l="ls -la"
alias ll="ls -lh"
alias update="pkg update && pkg upgrade -y && pkg autoclean"
alias reload="mkdir -p \${TMPDIR:-\$HOME/.cache} && date +%s > \${TMPDIR:-\$HOME/.cache}/.s24_auth_token && source ~/.bashrc"
alias edit="nano ~/.bashrc"
