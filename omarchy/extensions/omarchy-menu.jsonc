{
  // Extend the Quickshell Omarchy menu with JSONC.
  //
  // IDs are object keys. The parent is inferred from the dotted id, so
  // "personal.notes" appears under "personal", and "personal" appears on the
  // root menu. Reuse an existing id to override/extend it.

  // Dev Workflows switcher and launcher
  "trigger.workflows": {
    "icon": "⚡",
    "label": "Dev Workflows",
    "description": "Switch dev workflows and launch tailored tool stacks",
    "aliases": ["workflow", "workflows", "dev", "stack"],
    "action": "omarchy-workflow-menu"
  },

  // OMNI Remote Streaming: Hotspot Moonlight
  "trigger.hotspot-moonlight": {
    "icon": "󰤨",
    "label": "Hotspot Moonlight",
    "description": "Stream Desktop over hotspot (120fps low-latency)",
    "aliases": ["hotspot", "hotspot-moonlight", "moonlight-hotspot"],
    "action": "omni hotspot-moonlight"
  },

  // OMNI Remote Streaming: 5 GHz Wi-Fi Moonlight
  "trigger.wifi-moonlight": {
    "icon": "󰤨",
    "label": "5 GHz Moonlight",
    "description": "Stream Desktop over 5 GHz Wi-Fi (60fps 35Mbps HEVC)",
    "aliases": ["wifi-moonlight", "moonlight-wifi", "moonlight-5g", "5g-moonlight"],
    "action": "omni wifi-moonlight"
  },

  // OMNI Remote Streaming: 2.4 GHz Wi-Fi Moonlight
  "trigger.2g-moonlight": {
    "icon": "󰤨",
    "label": "2.4 GHz Moonlight",
    "description": "Stream Desktop over 2.4 GHz Wi-Fi (60fps 14Mbps stable)",
    "aliases": ["2g-moonlight", "moonlight-2g", "moonlight-2.4g", "2.4g-moonlight"],
    "action": "omni 2g-moonlight"
  },

  // AI Agents launcher & session manager
  "trigger.agents": {
    "icon": "󰚩",
    "label": "AI Agents",
    "description": "Launch, toggle, and view usage for Antigravity, Claude, Codex, Ollama",
    "aliases": ["agent", "agents", "agy", "claude", "codex", "ollama", "ai"],
    "action": "asus-agent-menu"
  },

  // Keyboard Backlight toggle under Trigger -> Toggle
  "trigger.toggle.keyboard-backlight": {
    "icon": "",
    "label": "Keyboard Backlight",
    "description": "Toggle ASUS ROG Flow 13 keyboard backlight",
    "aliases": ["keyboard", "kbd", "backlight"],
    "checked": "[[ $(brightnessctl --device='asus::kbd_backlight' get 2>/dev/null || echo 0) -gt 0 ]]",
    "action": "asus-kbd-sync toggle"
  },

  // Keyboard Backlight Schedule under Setup / Settings
  "setup.keyboard-backlight": {
    "icon": "",
    "label": "Keyboard Backlight Schedule",
    "description": "Configure auto turn-off/on schedule and brightness preset",
    "aliases": ["kbd-schedule", "keyboard-schedule"],
    "action": "asus-kbd-menu"
  },

  // Also under Trigger -> Hardware
  "trigger.hardware.keyboard-backlight": {
    "icon": "",
    "label": "Keyboard Backlight",
    "description": "Toggle ASUS ROG Flow 13 keyboard backlight",
    "aliases": ["keyboard-light", "kbd-light"],
    "checked": "[[ $(brightnessctl --device='asus::kbd_backlight' get 2>/dev/null || echo 0) -gt 0 ]]",
    "action": "asus-kbd-sync toggle"
  },

  // Dizzie System Updates in Trigger and Update submenus
  "trigger.dizziee-updater": {
    "icon": "󰚰",
    "label": "Dizzie System Updates",
    "description": "Open Dizzie system update checker and installer",
    "aliases": ["dizzie", "updater", "updates", "upgrade"],
    "action": "omarchy-shell shell toggle dizziee.system-updates"
  },
  "update.dizziee-updater": {
    "icon": "󰚰",
    "label": "Dizzie System Updates",
    "description": "Open Dizzie system update checker and installer",
    "aliases": ["dizzie", "updater", "updates"],
    "action": "omarchy-shell shell toggle dizziee.system-updates"
  }
}
