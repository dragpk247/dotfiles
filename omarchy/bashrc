# Inhibit system sleep/idle while connected via SSH (with 45m idle auto-logout)
if [ -n "$SSH_CONNECTION" ]; then
    export TMOUT=2700  # Automatically close shell after 45 minutes of inactivity
    if [ -z "$INHIBITED_SSH" ]; then
        export INHIBITED_SSH=1
        exec systemd-inhibit --what=idle:sleep:shutdown --who="SSH Session" --why="Active remote session" "$SHELL"
    fi
fi

