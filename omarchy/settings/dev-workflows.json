{
  "active_workflow": "ai-assisted",
  "workflows": [
    {
      "id": "ai-assisted",
      "name": "AI-Assisted Prototyping",
      "icon": "󰑮",
      "description": "Antigravity, Hermes, Aider, Claude Code, OpenCode, Codex, Ollama, SDLC",
      "tools": [
        {
          "name": "Antigravity (agy)",
          "icon": "🤖",
          "action": "omarchy-launch-or-focus agy \"kitty --class agy --title agy -e agy\""
        },
        {
          "name": "Hermes Agent",
          "icon": "⚕",
          "action": "omarchy-launch-or-focus hermes \"kitty --title hermes -e hermes\""
        },
        {
          "name": "Aider (Desktop Free Qwen 14B)",
          "icon": "⚡",
          "action": "kitty --class aider-float -e bash -ic aq"
        },
        {
          "name": "Aider (Claude Haiku)",
          "icon": "☁️",
          "action": "kitty --class aider-float -e bash -ic ah"
        },
        {
          "name": "AI SDLC Development Hub",
          "icon": "🚀",
          "action": "omarchy-sdlc-menu"
        },
        {
          "name": "Claude Code",
          "icon": "⚡",
          "action": "omarchy-launch-or-focus claude \"kitty --title claude -e claude\""
        },
        {
          "name": "OpenCode AI",
          "icon": "✨",
          "action": "omarchy-launch-or-focus opencode \"kitty --title opencode -e opencode\""
        },
        {
          "name": "Codex CLI",
          "icon": "💻",
          "action": "omarchy-launch-or-focus codex \"kitty --title codex -e codex\""
        },
        {
          "name": "AI Gateway Dashboard",
          "icon": "🌐",
          "action": "xdg-open http://localhost:8000/dashboard"
        },
        {
          "name": "Live Diff Watcher (hunk)",
          "icon": "󰚢",
          "action": "omarchy-launch-or-focus hunk-diff \"kitty --title hunk-diff -e hunk diff --watch\""
        },
        {
          "name": "Ollama Chat",
          "icon": "🦙",
          "action": "setsid kitty --title \"Ollama Chat\" -e ollama run llama3 >/dev/null 2>&1 &"
        },
        {
          "name": "Dropdown Scratchpad",
          "icon": "",
          "action": "toggle-dropdown-terminal"
        }
      ]
    },
    {
      "id": "herdr-prototyping",
      "name": "Herdr Swarms & Prototyping",
      "icon": "󰢹",
      "description": "Herdr Workspaces, Multi-Agent Swarms, Worktrees, Hunk Diff",
      "tools": [
        {
          "name": "Herdr Workspace",
          "icon": "",
          "action": "omarchy-launch-or-focus herdr 'kitty --title herdr -e herdr'"
        },
        {
          "name": "Herdr Dev Square (hds)",
          "icon": "⊞",
          "action": "omarchy-launch-or-focus herdr-hds 'kitty --title herdr -e bash -ic \"herdr && hds\"'"
        },
        {
          "name": "Dual AI Layout (hdl agy claude)",
          "icon": "👥",
          "action": "omarchy-launch-or-focus herdr-hdl 'kitty --title herdr -e bash -ic \"herdr && hdl agy claude\"'"
        },
        {
          "name": "4-Agent Swarm (hsl 4 agy)",
          "icon": "🐝",
          "action": "omarchy-launch-or-focus herdr-hsl 'kitty --title herdr -e bash -ic \"herdr && hsl 4 agy\"'"
        },
        {
          "name": "Git Worktree Manager",
          "icon": "🌱",
          "action": "omarchy-launch-or-focus herdr-worktree 'kitty --title herdr-worktree -e bash -c \"herdr worktree list; exec bash\"'"
        },
        {
          "name": "Live Diff Watcher (hunk)",
          "icon": "󰊢",
          "action": "omarchy-launch-or-focus hunk-diff 'kitty --title hunk-diff -e hunk diff --watch'"
        }
      ]
    },
